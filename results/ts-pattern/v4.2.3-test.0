				"package.json": {
					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,24 +1,57 @@\n {\n   \"name\": \"ts-pattern\",\n-  \"version\": \"4.2.3-test.0\",\n+  \"version\": \"5.9.2\",\n   \"description\": \" The exhaustive Pattern Matching library for TypeScript.\",\n-  \"main\": \"./dist/index.js\",\n-  \"module\": \"./dist/index.module.js\",\n-  \"exports\": \"./dist/foo.modern.mjs\",\n-  \"unpkg\": \"./dist/index.umd.js\",\n+  \"type\": \"module\",\n+  \"sideEffects\": false,\n+  \"source\": \"src/index.ts\",\n+  \"exports\": {\n+    \".\": {\n+      \"require\": {\n+        \"types\": \"./dist/index.d.cts\",\n+        \"default\": \"./dist/index.cjs\"\n+      },\n+      \"import\": {\n+        \"types\": \"./dist/index.d.ts\",\n+        \"default\": \"./dist/index.js\"\n+      },\n+      \"types\": \"./dist/index.d.ts\",\n+      \"default\": \"./dist/index.js\"\n+    },\n+    \"./types\": {\n+      \"require\": {\n+        \"types\": \"./dist/types/index.d.cts\"\n+      },\n+      \"import\": {\n+        \"types\": \"./dist/types/index.d.ts\"\n+      },\n+      \"types\": \"./dist/types/index.d.ts\"\n+    },\n+    \"./package.json\": \"./package.json\"\n+  },\n   \"types\": \"dist/index.d.ts\",\n+  \"main\": \"dist/index.cjs\",\n+  \"module\": \"dist/index.js\",\n+  \"unpkg\": \"dist/index.umd.js\",\n   \"scripts\": {\n-    \"build\": \"microbundle\",\n+    \"build\": \"rimraf dist && microbundle --format modern,cjs,umd && sh ./scripts/generate-cts.sh\",\n     \"dev\": \"microbundle watch\",\n     \"prepublishOnly\": \"npm run test && npm run build\",\n+    \"publish:jsr\": \"npm run prepublishOnly && npx jsr publish\",\n+    \"release\": \"npm run prepublishOnly && npm publish && npx jsr publish\",\n     \"test\": \"jest\",\n     \"clear-test\": \"jest --clearCache\",\n-    \"perf\": \"tsc --project tests/tsconfig.json --noEmit --extendedDiagnostics\",\n     \"fmt\": \"prettier ./src/** ./tests/** -w\",\n-    \"check\": \"tsc --strict --noEmit --extendedDiagnostics\"\n+    \"check\": \"tsc --strict --noEmit --extendedDiagnostics\",\n+    \"perf\": \"tsc --project tests/tsconfig.json --noEmit --extendedDiagnostics\",\n+    \"perf:compile-time\": \"tsc --project benchmarks/compile-time/tsconfig.json --extendedDiagnostics\",\n+    \"completions\": \"node scripts/completions/run.mjs\",\n+    \"trace\": \"tsc --project tests/tsconfig.json --generateTrace trace --incremental false  --noEmit\",\n+    \"analyzeTrace\": \"npx @typescript/analyze-trace trace\"\n   },\n   \"files\": [\n-    \"dist/**/*\"\n+    \"dist/**/*\",\n+    \"package.json\"\n   ],\n   \"repository\": {\n     \"type\": \"git\",\n@@ -41,11 +74,18 @@\n   },\n   \"homepage\": \"https://github.com/gvergnaud/ts-pattern#readme\",\n   \"devDependencies\": {\n-    \"@types/jest\": \"^27.0.2\",\n-    \"jest\": \"^27.4.5\",\n+    \"@types/jest\": \"^30.0.0\",\n+    \"jest\": \"^30.1.3\",\n     \"microbundle\": \"^0.15.1\",\n-    \"prettier\": \"^2.5.1\",\n-    \"ts-jest\": \"^27.1.2\",\n-    \"typescript\": \"^4.8.3\"\n+    \"prettier\": \"^2.8.8\",\n+    \"rimraf\": \"^5.0.1\",\n+    \"ts-jest\": \"^29.4.1\",\n+    \"typescript\": \"^5.9.2\"\n+  },\n+  \"overrides\": {\n+    \"microbundle\": {\n+      \".\": \"$microbundle\",\n+      \"rollup-plugin-typescript2\": \"0.37.0\"\n+    }\n   }\n }\n",
