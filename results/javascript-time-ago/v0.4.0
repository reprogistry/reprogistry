				"package.json": {
					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,62 +1,3472 @@\n {\n   \"name\": \"javascript-time-ago\",\n-  \"version\": \"0.4.0\",\n-  \"description\": \"International highly customizable relative time formatting\",\n-  \"main\": \"index.umd.js\",\n-  \"jsnext:main\": \"index.es6.js\",\n-  \"peerDependencies\": {\n-    \"intl-messageformat\": \"^1.3.0\"\n+  \"version\": \"2.6.4\",\n+  \"description\": \"Localized relative date/time formatting\",\n+  \"main\": \"index.cjs\",\n+  \"module\": \"index.js\",\n+  \"type\": \"module\",\n+  \"exports\": {\n+    \".\": {\n+      \"types\": \"./index.d.ts\",\n+      \"import\": \"./index.js\",\n+      \"require\": \"./index.cjs\"\n+    },\n+    \"./cache\": {\n+      \"import\": \"./cache/index.js\",\n+      \"require\": \"./cache/index.cjs\"\n+    },\n+    \"./gradation\": {\n+      \"import\": \"./gradation/index.js\",\n+      \"require\": \"./gradation/index.cjs\"\n+    },\n+    \"./steps\": {\n+      \"types\": \"./steps/index.d.ts\",\n+      \"import\": \"./steps/index.js\",\n+      \"require\": \"./steps/index.cjs\"\n+    },\n+    \"./load-all-locales\": {\n+      \"types\": \"./load-all-locales/index.d.ts\",\n+      \"import\": \"./load-all-locales/index.js\",\n+      \"require\": \"./load-all-locales/index.cjs\"\n+    },\n+    \"./prop-types\": {\n+      \"import\": \"./prop-types/index.js\",\n+      \"require\": \"./prop-types/index.cjs\"\n+    },\n+    \"./full-date-formatter\": {\n+      \"types\": \"./full-date-formatter/index.d.ts\",\n+      \"import\": \"./full-date-formatter/index.js\",\n+      \"require\": \"./full-date-formatter/index.cjs\"\n+    },\n+    \"./package.json\": \"./package.json\",\n+    \"./locale/af\": {\n+      \"types\": \"./locale/af.json.d.ts\",\n+      \"import\": \"./locale/af/index.js\",\n+      \"require\": \"./locale/af/index.cjs\"\n+    },\n+    \"./locale/af.json\": {\n+      \"types\": \"./locale/af.json.d.ts\",\n+      \"import\": \"./locale/af.json.js\"