n+    \"meow\": \"9.0.0\",\n+    \"mkdirp\": \"1.0.4\",\n+    \"terser\": \"5.18.1\"\n   },\n   \"devDependencies\": {\n-    \"grunt-contrib-jshint\": \"~0.6.4\",\n-    \"grunt-contrib-nodeunit\": \"~0.2.0\",\n-    \"grunt-contrib-watch\": \"~0.5.3\",\n-    \"grunt\": \"~0.4.2\",\n-    \"uglify-js\": \"~2.4.8\",\n-    \"mkdirp\": \"~0.3.5\"\n-  },\n-  \"keywords\": [],\n-  \"preferGlobal\": \"true\",\n-  \"bin\": {\n-    \"uglifyjs-folder\": \"lib/uglifyjs-folder.js\"\n+    \"ava\": \"5.1.0\",\n+    \"del\": \"6.1.1\",\n+    \"nyc\": \"15.1.0\",\n+    \"proxyquire\": \"2.1.3\",\n+    \"sinon\": \"15.0.1\"\n   }\n }\n",
