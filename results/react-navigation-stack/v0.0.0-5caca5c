					"diff": "--- published/lib/commonjs/views/Header/HeaderBackground.js.map\n+++ rebuilt/lib/commonjs/views/Header/HeaderBackground.js.map\n@@ -1 +1 @@\n-{\"version\":3,\"sources\":[\"HeaderBackground.tsx\"],\"names\":[\"HeaderBackground\",\"style\",\"rest\",\"styles\",\"container\",\"StyleSheet\",\"create\",\"flex\",\"backgroundColor\",\"Platform\",\"select\",\"android\",\"elevation\",\"ios\",\"shadowColor\",\"shadowOpacity\",\"shadowRadius\",\"shadowOffset\",\"width\",\"height\",\"hairlineWidth\",\"default\",\"boxShadow\"],\"mappings\":\"4hBAAA,oDACA,yC,yGAEe,QAASA,CAAAA,gBAAT,MAAyD,IAA7BC,CAAAA,KAA6B,MAA7BA,KAA6B,CAAnBC,IAAmB,uDACtE,MAAO,qBAAC,iBAAD,wBAAM,KAAK,CAAE,CAACC,MAAM,CAACC,SAAR,CAAmBH,KAAnB,CAAb,EAA4CC,IAA5C,kDAAP,CACD,CAED,GAAMC,CAAAA,MAAM,CAAGE,wBAAWC,MAAX,CAAkB,CAC/BF,SAAS,6BACPG,IAAI,CAAE,CADC,CAEPC,eAAe,CAAE,OAFV,EAGJC,sBAASC,MAAT,CAAgB,CACjBC,OAAO,CAAE,CACPC,SAAS,CAAE,CADJ,CADQ,CAIjBC,GAAG,CAAE,CACHC,WAAW,CAAE,oBADV,CAEHC,aAAa,CAAE,IAFZ,CAGHC,YAAY,CAAE,CAHX,CAIHC,YAAY,CAAE,CACZC,KAAK,CAAE,CADK,CAEZC,MAAM,CAAEd,wBAAWe,aAFP,CAJX,CAJY,CAajBC,OAAO,CAAE,CAGPC,SAAS,8FAHF,CAbQ,CAAhB,CAHI,CADsB,CAAlB,CAAf\",\"sourcesContent\":[\"import * as React from 'react';\\nimport { View, StyleSheet, Platform, ViewProps } from 'react-native';\\n\\nexport default function HeaderBackground({ style, ...rest }: ViewProps) {\\n  return <View style={[styles.container, style]} {...rest} />;\\n}\\n\\nconst styles = StyleSheet.create({\\n  container: {\\n    flex: 1,\\n    backgroundColor: 'white',\\n    ...Platform.select({\\n      android: {\\n        elevation: 4,\\n      },\\n      ios: {\\n        shadowColor: 'rgba(0, 0, 0, 0.3)',\\n        shadowOpacity: 0.85,\\n        shadowRadius: 0,\\n        shadowOffset: {\\n          width: 0,\\n          height: StyleSheet.hairlineWidth,\\n        },\\n      },\\n      default: {\\n        // https://github.com/necolas/react-native-web/issues/44\\n        // Material Design\\n        boxShadow: `0 2px 4px -1px rgba(0,0,0,0.2), 0 4px 5px 0 rgba(0,0,0,0.14), 0 1px 10px 0 rgba(0,0,0,0.12)`,\\n      },\\n    }),\\n  },\\n});\\n\"]}\n\\ No newline at end of file\n+{\"version\":3,\"sources\":[\"HeaderBackground.tsx\"],\"names\":[\"HeaderBackground\",\"style\",\"rest\",\"styles\",\"container\",\"StyleSheet\",\"create\",\"flex\",\"backgroundColor\",\"Platform\",\"select\",\"android\",\"elevation\",\"ios\",\"shadowColor\",\"shadowOpacity\",\"shadowRadius\",\"shadowOffset\",\"width\",\"height\",\"hairlineWidth\",\"default\",\"boxShadow\"],\"mappings\":\"4hBAAA,oDACA,yC,qGAEe,QAASA,CAAAA,gBAAT,MAAyD,IAA7BC,CAAAA,KAA6B,MAA7BA,KAA6B,CAAnBC,IAAmB,uDACtE,MAAO,qBAAC,iBAAD,wBAAM,KAAK,CAAE,CAACC,MAAM,CAACC,SAAR,CAAmBH,KAAnB,CAAb,EAA4CC,IAA5C,kDAAP,CACD,CAED,GAAMC,CAAAA,MAAM,CAAGE,wBAAWC,MAAX,CAAkB,CAC/BF,SAAS,6BACPG,IAAI,CAAE,CADC,CAEPC,eAAe,CAAE,OAFV,EAGJC,sBAASC,MAAT,CAAgB,CACjBC,OAAO,CAAE,CACPC,SAAS,CAAE,CADJ,CADQ,CAIjBC,GAAG,CAAE,CACHC,WAAW,CAAE,oBADV,CAEHC,aAAa,CAAE,IAFZ,CAGHC,YAAY,CAAE,CAHX,CAIHC,YAAY,CAAE,CACZC,KAAK,CAAE,CADK,CAEZC,MAAM,CAAEd,wBAAWe,aAFP,CAJX,CAJY,CAajBC,OAAO,CAAE,CAGPC,SAAS,8FAHF,CAbQ,CAAhB,CAHI,CADsB,CAAlB,CAAf\",\"sourcesContent\":[\"import * as React from 'react';\\nimport { View, StyleSheet, Platform, ViewProps } from 'react-native';\\n\\nexport default function HeaderBackground({ style, ...rest }: ViewProps) {\\n  return <View style={[styles.container, style]} {...rest} />;\\n}\\n\\nconst styles = StyleSheet.create({\\n  container: {\\n    flex: 1,\\n    backgroundColor: 'white',\\n    ...Platform.select({\\n      android: {\\n        elevation: 4,\\n      },\\n      ios: {\\n        shadowColor: 'rgba(0, 0, 0, 0.3)',\\n        shadowOpacity: 0.85,\\n        shadowRadius: 0,\\n        shadowOffset: {\\n          width: 0,\\n          height: StyleSheet.hairlineWidth,\\n        },\\n      },\\n      default: {\\n        // https://github.com/necolas/react-native-web/issues/44\\n        // Material Design\\n        boxShadow: `0 2px 4px -1px rgba(0,0,0,0.2), 0 4px 5px 0 rgba(0,0,0,0.14), 0 1px 10px 0 rgba(0,0,0,0.12)`,\\n      },\\n    }),\\n  },\\n});\\n\"]}\n\\ No newline at end of file\n",
