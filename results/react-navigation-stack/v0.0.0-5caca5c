					"diff": "--- published/lib/module/views/Header/HeaderBackground.js.map\n+++ rebuilt/lib/module/views/Header/HeaderBackground.js.map\n@@ -1 +1 @@\n-{\"version\":3,\"sources\":[\"HeaderBackground.tsx\"],\"names\":[\"React\",\"View\",\"StyleSheet\",\"Platform\",\"HeaderBackground\",\"style\",\"rest\",\"styles\",\"container\",\"create\",\"flex\",\"backgroundColor\",\"select\",\"android\",\"elevation\",\"ios\",\"shadowColor\",\"shadowOpacity\",\"shadowRadius\",\"shadowOffset\",\"width\",\"height\",\"hairlineWidth\",\"default\",\"boxShadow\"],\"mappings\":\"kTAAA,MAAO,GAAKA,CAAAA,KAAZ,KAAuB,OAAvB,CACA,OAASC,IAAT,CAAeC,UAAf,CAA2BC,QAA3B,KAAsD,cAAtD,CAEA,cAAe,SAASC,CAAAA,gBAAT,MAAyD,IAA7BC,CAAAA,KAA6B,MAA7BA,KAA6B,CAAnBC,IAAmB,0CACtE,MAAO,qBAAC,IAAD,WAAM,KAAK,CAAE,CAACC,MAAM,CAACC,SAAR,CAAmBH,KAAnB,CAAb,EAA4CC,IAA5C,kDAAP,CACD,CAED,GAAMC,CAAAA,MAAM,CAAGL,UAAU,CAACO,MAAX,CAAkB,CAC/BD,SAAS,gBACPE,IAAI,CAAE,CADC,CAEPC,eAAe,CAAE,OAFV,EAGJR,QAAQ,CAACS,MAAT,CAAgB,CACjBC,OAAO,CAAE,CACPC,SAAS,CAAE,CADJ,CADQ,CAIjBC,GAAG,CAAE,CACHC,WAAW,CAAE,oBADV,CAEHC,aAAa,CAAE,IAFZ,CAGHC,YAAY,CAAE,CAHX,CAIHC,YAAY,CAAE,CACZC,KAAK,CAAE,CADK,CAEZC,MAAM,CAAEnB,UAAU,CAACoB,aAFP,CAJX,CAJY,CAajBC,OAAO,CAAE,CAGPC,SAAS,8FAHF,CAbQ,CAAhB,CAHI,CADsB,CAAlB,CAAf\",\"sourcesContent\":[\"import * as React from 'react';\\nimport { View, StyleSheet, Platform, ViewProps } from 'react-native';\\n\\nexport default function HeaderBackground({ style, ...rest }: ViewProps) {\\n  return <View style={[styles.container, style]} {...rest} />;\\n}\\n\\nconst styles = StyleSheet.create({\\n  container: {\\n    flex: 1,\\n    backgroundColor: 'white',\\n    ...Platform.select({\\n      android: {\\n        elevation: 4,\\n      },\\n      ios: {\\n        shadowColor: 'rgba(0, 0, 0, 0.3)',\\n        shadowOpacity: 0.85,\\n        shadowRadius: 0,\\n        shadowOffset: {\\n          width: 0,\\n          height: StyleSheet.hairlineWidth,\\n        },\\n      },\\n      default: {\\n        // https://github.com/necolas/react-native-web/issues/44\\n        // Material Design\\n        boxShadow: `0 2px 4px -1px rgba(0,0,0,0.2), 0 4px 5px 0 rgba(0,0,0,0.14), 0 1px 10px 0 rgba(0,0,0,0.12)`,\\n      },\\n    }),\\n  },\\n});\\n\"]}\n\\ No newline at end of file\n+{\"version\":3,\"sources\":[\"HeaderBackground.tsx\"],\"names\":[\"React\",\"View\",\"StyleSheet\",\"Platform\",\"HeaderBackground\",\"style\",\"rest\",\"styles\",\"container\",\"create\",\"flex\",\"backgroundColor\",\"select\",\"android\",\"elevation\",\"ios\",\"shadowColor\",\"shadowOpacity\",\"shadowRadius\",\"shadowOffset\",\"width\",\"height\",\"hairlineWidth\",\"default\",\"boxShadow\"],\"mappings\":\"8SAAA,MAAO,GAAKA,CAAAA,KAAZ,KAAuB,OAAvB,CACA,OAASC,IAAT,CAAeC,UAAf,CAA2BC,QAA3B,KAAsD,cAAtD,CAEA,cAAe,SAASC,CAAAA,gBAAT,MAAyD,IAA7BC,CAAAA,KAA6B,MAA7BA,KAA6B,CAAnBC,IAAmB,0CACtE,MAAO,qBAAC,IAAD,WAAM,KAAK,CAAE,CAACC,MAAM,CAACC,SAAR,CAAmBH,KAAnB,CAAb,EAA4CC,IAA5C,kDAAP,CACD,CAED,GAAMC,CAAAA,MAAM,CAAGL,UAAU,CAACO,MAAX,CAAkB,CAC/BD,SAAS,gBACPE,IAAI,CAAE,CADC,CAEPC,eAAe,CAAE,OAFV,EAGJR,QAAQ,CAACS,MAAT,CAAgB,CACjBC,OAAO,CAAE,CACPC,SAAS,CAAE,CADJ,CADQ,CAIjBC,GAAG,CAAE,CACHC,WAAW,CAAE,oBADV,CAEHC,aAAa,CAAE,IAFZ,CAGHC,YAAY,CAAE,CAHX,CAIHC,YAAY,CAAE,CACZC,KAAK,CAAE,CADK,CAEZC,MAAM,CAAEnB,UAAU,CAACoB,aAFP,CAJX,CAJY,CAajBC,OAAO,CAAE,CAGPC,SAAS,8FAHF,CAbQ,CAAhB,CAHI,CADsB,CAAlB,CAAf\",\"sourcesContent\":[\"import * as React from 'react';\\nimport { View, StyleSheet, Platform, ViewProps } from 'react-native';\\n\\nexport default function HeaderBackground({ style, ...rest }: ViewProps) {\\n  return <View style={[styles.container, style]} {...rest} />;\\n}\\n\\nconst styles = StyleSheet.create({\\n  container: {\\n    flex: 1,\\n    backgroundColor: 'white',\\n    ...Platform.select({\\n      android: {\\n        elevation: 4,\\n      },\\n      ios: {\\n        shadowColor: 'rgba(0, 0, 0, 0.3)',\\n        shadowOpacity: 0.85,\\n        shadowRadius: 0,\\n        shadowOffset: {\\n          width: 0,\\n          height: StyleSheet.hairlineWidth,\\n        },\\n      },\\n      default: {\\n        // https://github.com/necolas/react-native-web/issues/44\\n        // Material Design\\n        boxShadow: `0 2px 4px -1px rgba(0,0,0,0.2), 0 4px 5px 0 rgba(0,0,0,0.14), 0 1px 10px 0 rgba(0,0,0,0.12)`,\\n      },\\n    }),\\n  },\\n});\\n\"]}\n\\ No newline at end of file\n",
