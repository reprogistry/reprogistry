					"diff": "--- published/test/onPort.test.js\n+++ rebuilt/test/onPort.test.js\n@@ -1,17 +1,19 @@\n 'use strict'\n \n const path = require('path')\n-const { test } = require('tap')\n+const { test } = require('node:test')\n const spawn = require('child_process').spawn\n+const { once } = require('events')\n const split = require('split2')\n const hasAsyncHooks = require('has-async-hooks')\n \n-test('--on-port flag', { skip: !hasAsyncHooks() }, (t) => {\n+test('--on-port flag', { skip: !hasAsyncHooks(), timeout: 30000 }, (t) => {\n   const lines = [\n     /Running 1s test @ .*$/,\n     /10 connections.*$/,\n     /$/,\n     /.*/,\n+    /$/,\n     /Stat.*2\\.5%.*50%.*97\\.5%.*99%.*Avg.*Stdev.*Max.*$/,\n     /.*/,\n     /Latency.*$/,\n@@ -25,11 +27,12 @@\n     /.*/,\n     /$/,\n     /Req\\/Bytes counts sampled once per second.*$/,\n+    /# of samples: 10*$/,\n     /$/,\n     /.* requests in ([0-9]|\\.)+s, .* read/\n   ]\n \n-  t.plan(lines.length * 2)\n+  t.plan(lines.length * 2, { wait: true })\n \n   const child = spawn(process.execPath, [\n     path.join(__dirname, '..'),\n@@ -44,16 +47,76 @@\n     detached: false\n   })\n \n-  t.tearDown(() => {\n-    child.kill()\n+  t.after(() => waitForExit(child))\n+\n+  child\n+    .stderr\n+    .pipe(split())\n+    .on('data', (line) => {\n+      const regexp = lines.shift()\n+      t.assert.ok(regexp, 'we are expecting this line')\n+      t.assert.ok(regexp.test(line), 'line matches ' + regexp)\n+    })\n+})\n+\n+test('assume --on-port flag if -- node is set', { skip: !hasAsyncHooks(), timeout: 30000 }, (t) => {\n+  const lines = [\n+    /Running 1s test @ .*$/,\n+    /10 connections.*$/,\n+    /$/,\n+    /.*/,\n+    /$/,\n+    /Stat.*2\\.5%.*50%.*97\\.5%.*99%.*Avg.*Stdev.*Max.*$/,\n+    /.*/,\n+    /Latency.*$/,\n+    /$/,\n+    /.*/,\n+    /Stat.*1%.*2\\.5%.*50%.*97\\.5%.*Avg.*Stdev.*Min.*$/,\n+    /.*/,\n+    /Req\\/Sec.*$/,\n+    /$/,\n+    /Bytes\\/Sec.*$/,\n+    /.*/,\n+    /$/,\n+    /Req\\/Bytes counts sampled once per second.*$/,\n+    /# of samples: 10*$/,\n+    /$/,\n+    /.* requests in ([0-9]|\\.)+s, .* read/\n+  ]\n+\n+  t.plan(lines.length * 2, { wait: true })\n+\n+  const child = spawn(process.execPath, [\n+    path.join(__dirname, '..'),\n+    '-c', '10',\n+    '-d', '1',\n+    '/',\n+    '--', 'node', path.join(__dirname, './targetProcess')\n+  ], {\n+    cwd: __dirname,\n+    env: process.env,\n+    stdio: ['ignore', 'pipe', 'pipe'],\n+    detached: false\n   })\n \n+  t.after(() => waitForExit(child))\n+\n   child\n     .stderr\n",
