name, '..'), '-d', '1', '-S', socketPath, 'example.com/foo'], {\n+    cwd: __dirname,\n+    env: process.env,\n+    stdio: ['ignore', 'pipe', 'pipe'],\n+    detached: false\n+  })\n+  t.after(() => child.kill())\n+  const closed = once(child, 'close')\n \n+  let errorLine = false\n+  for await (const line of child.stderr.pipe(split())) {\n+    const regexp = lines.shift()\n     if (regexp) {\n-      t.ok(regexp.test(line), 'line matches ' + regexp)\n-\n-      if (lastLine && win) {\n-        // We can't be sure the error line is outputted on Windows, so in case\n-        // this really is the last line, we'll set a timer to auto-end the test\n-        // in case there are no more lines.\n-        failsafeTimer = setTimeout(function () {\n-          t.end()\n-        }, 1000)\n-      }\n+      t.assert.match(line, regexp)\n     } else if (!errorLine && win) {\n-      // On Windows a few errors are expected. We'll accept a 1% error rate on\n-      // the pipe.\n+      // On Windows a few errors are expected. Accept a 1% error rate on the pipe.\n       errorLine = true\n-      clearTimeout(failsafeTimer)\n",
