);\n+            expect(parseInt(this.el.getAttribute('data-medium-editor-editor-index'))).toBe(editor.id);\n+            editor.destroy();\n+            expect(this.el.hasAttribute('data-medium-editor-editor-index')).toBe(false);\n+        });\n     });\n });\n",
