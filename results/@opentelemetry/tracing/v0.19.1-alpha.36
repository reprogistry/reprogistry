2.0\",\n+    \"@typescript-eslint/parser\": \"4.22.0\",\n+    \"beautify-benchmark\": \"0.2.4\",\n+    \"benchmark\": \"2.1.4\",\n+    \"eslint\": \"7.24.0\",\n+    \"eslint-config-airbnb-base\": \"14.2.1\",\n+    \"eslint-plugin-header\": \"3.1.1\",\n+    \"eslint-plugin-import\": \"2.22.1\",\n",
