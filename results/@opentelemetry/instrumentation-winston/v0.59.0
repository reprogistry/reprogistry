				"package.json": {
					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,64 +1,106 @@\n {\n-  \"name\": \"@opentelemetry/instrumentation-winston\",\n-  \"version\": \"0.59.0\",\n-  \"description\": \"OpenTelemetry instrumentation for `winston` logger\",\n-  \"main\": \"build/src/index.js\",\n-  \"types\": \"build/src/index.d.ts\",\n+  \"name\": \"opentelemetry-js-contrib\",\n+  \"version\": \"0.1.0\",\n+  \"description\": \"This is a repository for OpenTelemetry JavaScript contributions.\",\n   \"repository\": {\n     \"type\": \"git\",\n-    \"url\": \"https://github.com/open-telemetry/opentelemetry-js-contrib.git\",\n-    \"directory\": \"packages/instrumentation-winston\"\n+    \"url\": \"https://github.com/open-telemetry/opentelemetry-js-contrib.git\"\n+  },\n+  \"publishConfig\": {\n+    \"access\": \"public\"\n   },\n   \"scripts\": {\n-    \"clean\": \"rimraf build/*\",\n-    \"compile\": \"tsc -p .\",\n-    \"compile:with-dependencies\": \"nx run-many -t compile -p @opentelemetry/instrumentation-winston\",\n-    \"lint:readme\": \"node ../../scripts/lint-readme.js\",\n-    \"prepublishOnly\": \"npm run compile\",\n-    \"test\": \"nyc --no-clean mocha 'test/**/*.test.ts'\",\n-    \"test-all-versions\": \"tav\",\n-    \"version:update\": \"node ../../scripts/version-update.js\"\n+    \"clean\": \"nx run-many -t clean\",\n+    \"version:update\": \"nx run-many -t version:update\",\n+    \"compile\": \"nx run-many -t compile\",\n+    \"compile:ci:affected\": \"nx affected -t compile\",\n+    \"list:affected\": \"nx affected -t test-all-versions --graph=stdout | jq -c '.tasks.tasks[].target.project'\",\n+    \"test\": \"nx run-many -t test\",\n+    \"test:ci:affected\": \"cross-env NODE_OPTIONS='-r dotenv/config' DOTENV_CONFIG_PATH=./test/test-services.env nx affected -t test\",\n+    \"test:browser\": \"nx run-many -t test:browser\",\n+    \"test:browser:ci:affected\": \"nx affected -t test:browser\",\n+    \"test-all-versions\": \"cross-env NPM_CONFIG_MIN_RELEASE_AGE=0 npm run --if-present test-all-versions --workspaces\",\n+    \"test-all-versions:ci:affected\": \"cross-env NODE_OPTIONS='-r dotenv/config' DOTENV_CONFIG_PATH=./test/test-services.env NPM_CONFIG_MIN_RELEASE_AGE=0 sh -c 'npm --loglevel=silent run list:affected | xargs -I {} -t npm run --if-present test-all-versions -w {}'\",\n+    \"test-services:start\": \"docker compose -f ./test/docker-compose.yaml up -d --wait\",\n+    \"test-services:start:affected\": \"docker compose -f test/docker-compose.yaml up -d --wait $(./scripts/npm-run-on-affected.sh -s --if-present test-services:ls)\",\n+    \"test-services:stop\": \"docker compose -f ./test/docker-compose.yaml down\",\n+    \"test:with-services-env\": \"cross-env NODE_OPTIONS='-r dotenv/config' DOTENV_CONFIG_PATH=./test/test-services.env npm test\",\n+    \"test-all-versions:with-services-env\": \"cross-env NODE_OPTIONS='-r dotenv/config' DOTENV_CONFIG_PATH=./test/test-services.env npm run test-all-versions\",\n+    \"lint\": \"nx run-many -t lint && npm run lint:prettier && npm run lint:deps && npm run lint:readme && npm run lint:markdown && npm run lint:semconv-deps\",\n+    \"lint:fix\": \"nx run-many -t lint --fix && npm run lint:prettier:fix && npm run lint:markdown:fix\",\n+    \"lint:deps\": \"knip --dependencies --production --tags=-knipignore # requires Node.js 24 or later\",\n+    \"lint:markdown\": \"markdownlint-cli2 $(git ls-files '*.md')\",\n+    \"lint:markdown:fix\": \"markdownlint-cli2 --fix $(git ls-files '*.md')\",\n+    \"lint:prettier\": \"prettier --check .\",\n+    \"lint:prettier:fix\": \"prettier --write .\",\n+    \"lint:readme\": \"nx run-many -t lint:readme\",\n+    \"lint:release-please\": \"node scripts/check-release-please.mjs\",\n+    \"lint:semconv-deps\": \"./scripts/lint-semconv-deps.mjs -x packages/contrib-test-utils/src/resource-assertions.ts\"\n   },\n   \"keywords\": [\n-    \"instrumentation\",\n-    \"logging\",\n-    \"nodejs\",\n     \"opentelemetry\",\n+    \"nodejs\",\n     \"profiling\",\n-    \"tracing\",\n-    \"winston\"\n+    \"metrics\",\n+    \"stats\",\n+    \"plugins\"\n   ],\n   \"author\": \"OpenTelemetry Authors\",\n   \"license\": \"Apache-2.0\",\n-  \"engines\": {\n-    \"node\": \"^18.19.0 || >=20.6.0\"\n-  },\n-  \"files\": [\n-    \"build/src/**/*.js\",\n-    \"build/src/**/*.js.map\",\n-    \"build/src/**/*.d.ts\"\n-  ],\n-  \"publishConfig\": {\n-    \"access\": \"public\"\n-  },\n-  \"peerDependencies\": {\n-    \"@opentelemetry/api\": \"^1.3.0\"\n-  },\n   \"devDependencies\": {\n-    \"@opentelemetry/api\": \"^1.3.0\",\n-    \"@opentelemetry/context-async-hooks\": \"^2.0.0\",\n-    \"@opentelemetry/sdk-logs\": \"^0.215.0\",\n-    \"@opentelemetry/sdk-trace-base\": \"^2.0.0\",\n-    \"@opentelemetry/sdk-trace-node\": \"^2.0.0\",\n-    \"@opentelemetry/winston-transport\": \"^0.25.0\",\n-    \"@types/triple-beam\": \"^1.3.2\",\n-    \"winston\": \"3.3.3\",\n-    \"winston2\": \"npm:winston@2.4.7\"\n-  },\n-  \"dependencies\": {\n-    \"@opentelemetry/api-logs\": \"^0.215.0\",\n-    \"@opentelemetry/instrumentation\": \"^0.215.0\"\n",
