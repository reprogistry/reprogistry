				"package.json": {
					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -2,6 +2,7 @@\n   \"name\": \"vite-plugin-inspect\",\n   \"type\": \"module\",\n   \"version\": \"10.1.0\",\n+  \"packageManager\": \"pnpm@9.15.4\",\n   \"description\": \"Inspect the intermediate state of Vite plugins\",\n   \"author\": \"Anthony Fu <anthonyfu117@hotmail.com>\",\n   \"license\": \"MIT\",\n@@ -58,6 +59,19 @@\n   \"engines\": {\n     \"node\": \">=14\"\n   },\n+  \"scripts\": {\n+    \"build\": \"rimraf dist && run-s build:* && esno ./scripts/postbuild.ts && pnpm run test:attw\",\n+    \"build:client\": \"vite build src/client\",\n+    \"build:js\": \"unbuild\",\n+    \"dev\": \"nr stub && cross-env INSPECT_DEV=true vite src/client\",\n+    \"dev:client\": \"vite build src/client --watch\",\n+    \"stub\": \"unbuild --stub\",\n+    \"lint\": \"eslint .\",\n+    \"typecheck\": \"vue-tsc --noEmit\",\n+    \"test:attw\": \"attw --pack\",\n+    \"prepublishOnly\": \"npm run build\",\n+    \"release\": \"bumpp && npm publish\"\n+  },\n   \"peerDependencies\": {\n     \"vite\": \"^6.0.0\"\n   },\n@@ -140,17 +154,5 @@\n     \"*.{js,ts,vue,md}\": [\n       \"eslint --cache --fix\"\n     ]\n-  },\n-  \"scripts\": {\n-    \"build\": \"rimraf dist && run-s build:* && esno ./scripts/postbuild.ts && pnpm run test:attw\",\n-    \"build:client\": \"vite build src/client\",\n-    \"build:js\": \"unbuild\",\n-    \"dev\": \"nr stub && cross-env INSPECT_DEV=true vite src/client\",\n-    \"dev:client\": \"vite build src/client --watch\",\n-    \"stub\": \"unbuild --stub\",\n-    \"lint\": \"eslint .\",\n-    \"typecheck\": \"vue-tsc --noEmit\",\n-    \"test:attw\": \"attw --pack\",\n-    \"release\": \"bumpp && pnpm publish\"\n   }\n-}\n\\ No newline at end of file\n+}\n",
