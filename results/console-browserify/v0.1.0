st/index.js -b | tap-spec\",\n     \"build\": \"browserify test/index.js -o test/static/bundle.js\",\n-    \"testem\": \"testem\",\n-    \"postinstall\": \"npm dedup\"\n+    \"testem\": \"testem\"\n   },\n   \"testling\": {\n     \"files\": \"test/index.js\",\n-    \"browsers\": {\n-      \"ie\": [\n-        \"6\",\n-        \"7\",\n-        \"8\",\n-        \"9\",\n-        \"10\"\n-      ],\n-      \"firefox\": [\n-        \"16\",\n-        \"17\",\n-        \"nightly\"\n-      ],\n-      \"chrome\": [\n-        \"22\",\n-        \"23\",\n-        \"canary\"\n-      ],\n-      \"opera\": [\n-        \"12\",\n-        \"next\"\n-      ],\n-      \"safari\": [\n-        \"5.1\"\n-      ]\n-    }\n+    \"browsers\": [\n+      \"ie/8..latest\",\n+      \"firefox/16..latest\",\n+      \"firefox/nightly\",\n+      \"chrome/22..latest\",\n+      \"chrome/canary\",\n+      \"opera/12..latest\",\n+      \"opera/next\",\n+      \"safari/5.1..latest\",\n+      \"ipad/6.0..latest\",\n+      \"iphone/6.0..latest\",\n+      \"android-browser/4.2..latest\"\n+    ]\n",
