				"package.json": {
					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,17 +1,54 @@\n {\n   \"name\": \"@po-ui/style\",\n   \"version\": \"6.1.0\",\n-  \"description\": \"PO UI - Theme\",\n+  \"description\": \"PO Style\",\n   \"author\": \"PO UI\",\n   \"license\": \"MIT\",\n   \"repository\": {\n     \"type\": \"git\",\n     \"url\": \"https://github.com/po-ui/po-style\"\n   },\n+  \"scripts\": {\n+    \"build\": \"gulp build && gulp build:cli\",\n+    \"build:app\": \"gulp build:app\",\n+    \"build:cli\": \"gulp build:cli\",\n+    \"build:icon\": \"node icon-generator\",\n+    \"watch\": \"gulp watch\",\n+    \"dev\": \"http-server ./app-dist -o -c-1\",\n+    \"release\": \"standard-version --preset angular\",\n+    \"format:fix\": \"pretty-quick --staged\",\n+    \"format:check\": \"prettier --check --loglevel error \\\"src/**/*{.ts,.js,.json,.css,.scss,.html}\\\"\",\n+    \"format:all\": \"prettier --write \\\"src/**/*{.ts,.js,.json,.css,.scss,.html}\\\"\"\n+  },\n+  \"devDependencies\": {\n+    \"@commitlint/cli\": \"^11.0.0\",\n+    \"@commitlint/config-angular\": \"^11.0.0\",\n+    \"autoprefixer\": \"^9.8.6\",\n+    \"cssnano\": \"^4.1.10\",\n+    \"del\": \"^6.0.0\",\n+    \"gulp\": \"4.0.2\",\n+    \"gulp-concat\": \"^2.6.1\",\n+    \"gulp-copy\": \"^4.0.1\",\n+    \"gulp-minify\": \"^3.1.0\",\n+    \"gulp-postcss\": \"^8.0.0\",\n+    \"gulp-rename\": \"^2.0.0\",\n+    \"gulp-tap\": \"^2.0.0\",\n+    \"http-server\": \"^0.12.3\",\n+    \"husky\": \"^4.2.5\",\n+    \"postcss-apply\": \"^0.12.0\",\n+    \"postcss-custom-properties\": \"^9.1.1\",\n+    \"postcss-import\": \"^12.0.1\",\n+    \"postcss-nested\": \"^4.2.3\",\n+    \"standard-version\": \"^9.0.0\",\n+    \"xml2js\": \"^0.4.23\",\n+    \"yargs\": \"^16.1.1\",\n+    \"prettier\": \"2.2.0\",\n+    \"pretty-quick\": \"^3.1.0\"\n+  },\n   \"standard-version\": {\n     \"skip\": {\n       \"commit\": true,\n       \"tag\": true\n     }\n   }\n-}\n\\ No newline at end of file\n+}\n",
