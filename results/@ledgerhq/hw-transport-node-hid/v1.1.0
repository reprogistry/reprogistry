					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,41 +1,42 @@\n {\n-  \"name\": \"@ledgerhq/hw-transport-node-hid\",\n+  \"name\": \"ledgerco\",\n   \"version\": \"1.1.0\",\n-  \"description\": \"Ledger Hardware Wallet Node implementation of the communication layer, using node-hid\",\n-  \"keywords\": [\n-    \"Ledger\",\n-    \"LedgerWallet\",\n-    \"hid\",\n-    \"node-hid\",\n-    \"NanoS\",\n-    \"Blue\",\n-    \"Hardware Wallet\"\n-  ],\n+  \"description\": \"Node API for Ledger Hardware Wallets (HW.1 / Nano / Nano S / Blue)\",\n+  \"main\": \"./src/index.js\",\n+  \"scripts\": {\n+    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"\n+  },\n   \"repository\": {\n     \"type\": \"git\",\n     \"url\": \"https://github.com/LedgerHQ/ledger-node-js-api\"\n   },\n+  \"keywords\": [\n+    \"Ledger\",\n+    \"Wallet\",\n+    \"HW.1\",\n+    \"Bitcoin\",\n+    \"Ethereum\",    \n+    \"Hardware Wallet\"\n+  ],\n+  \"author\": \"Nicolas Bacca\",\n+  \"license\": \"Apache-2.0\",\n   \"bugs\": {\n     \"url\": \"https://github.com/LedgerHQ/ledger-node-js-api/issues\"\n   },\n   \"homepage\": \"https://github.com/LedgerHQ/ledger-node-js-api\",\n-  \"publishConfig\": {\n-    \"access\": \"public\"\n-  },\n-  \"main\": \"lib/TransportNodeHid.js\",\n-  \"license\": \"Apache-2.0\",\n   \"dependencies\": {\n-    \"@ledgerhq/hw-transport\": \"^1.1.0\",\n-    \"node-hid\": \"^0.7.2\"\n+\t  \"node-hid\": \"0.5.4\",\n+\t  \"q\": \"1.4.1\",\n+\t  \"async\" : \"2.1.4\"\n   },\n   \"devDependencies\": {\n-    \"flow-bin\": \"^0.63.1\",\n-    \"flow-typed\": \"^2.2.3\"\n+    \"browserify\": \"13.1.0\",\n+    \"uglify-js\": \"2.7.3\"\n   },\n   \"scripts\": {\n-    \"flow\": \"flow\",\n-    \"clean\": \"rm -rf lib/\",\n-    \"build\": \"cd ../.. && export PATH=$(yarn bin):$PATH && cd - && babel --source-maps -d lib src && flow-copy-source -v src lib\",\n-    \"watch\": \"cd ../.. && export PATH=$(yarn bin):$PATH && cd - && babel --watch --source-maps -d lib src & flow-copy-source -w -v src lib\"\n+    \"browserify\": \"browserify --im -o browser/ledger.js src/index-browserify.js\",\n+    \"uglify\": \"uglifyjs -o browser/ledger.min.js browser/ledger.js\",\n+    \"clean\": \"rm -f browser/ledger.js browser/ledger.min.js\"\n   }\n }\n+\n",
