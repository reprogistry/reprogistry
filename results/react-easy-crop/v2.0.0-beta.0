					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,36 +1,109 @@\n {\n   \"name\": \"react-easy-crop\",\n-  \"version\": \"2.0.0-beta.0\",\n+  \"version\": \"6.2.5\",\n   \"description\": \"A React component to crop images/videos with easy interactions\",\n-  \"files\": [\n-    \"dist\"\n+  \"homepage\": \"https://ValentinH.github.io/react-easy-crop/\",\n+  \"keywords\": [\n+    \"react\",\n+    \"crop\",\n+    \"cropper\",\n+    \"image crop\"\n   ],\n-  \"sideEffects\": false,\n-  \"homepage\": \"https://ricardo-ch.github.io/react-easy-crop/\",\n   \"repository\": {\n     \"type\": \"git\",\n-    \"url\": \"https://github.com/ricardo-ch/react-easy-crop\"\n+    \"url\": \"https://github.com/ValentinH/react-easy-crop\"\n   },\n   \"publishConfig\": {\n     \"registry\": \"https://registry.npmjs.org/\"\n   },\n-  \"author\": \"Ricardo.ch\",\n+  \"author\": \"Valentin Hervieu <valentin@hervi.eu>\",\n   \"license\": \"MIT\",\n+  \"packageManager\": \"pnpm@11.5.2\",\n+  \"sideEffects\": false,\n+  \"scripts\": {\n+    \"start\": \"vite ./examples --port 3001 --clearScreen false\",\n+    \"auto\": \"auto\",\n+    \"postversion\": \"pnpm build\",\n+    \"build\": \"tsdown && pnpm build:copy-files && pnpm test:build-types\",\n+    \"test:build-types\": \"node ./scripts/check-build-types.js\",\n+    \"docs:start\": \"pnpm --dir docs start\",\n+    \"docs:build\": \"pnpm --dir docs build\",\n+    \"docs:deploy\": \"pnpm --dir docs deploy\",\n+    \"test\": \"pnpm unit && pnpm e2e && pnpm lint\",\n+    \"unit\": \"vitest run src\",\n+    \"unit:watch\": \"vitest src\",\n+    \"start:ci\": \"vite ./examples --port 3001 --mode production\",\n+    \"e2e\": \"start-server-and-test start http://localhost:3001 cy:run\",\n+    \"e2e:ci\": \"start-server-and-test start:ci http://localhost:3001 cy:ci\",\n+    \"cy:open\": \"cypress open\",\n+    \"cy:run\": \"cypress run\",\n+    \"cy:ci\": \"percy exec -- cypress run --record\",\n+    \"lint\": \"eslint --ext .ts,.tsx ./examples ./src\",\n+    \"type-check\": \"tsc --noEmit\",\n+    \"prebuild\": \"rimraf dist\",\n+    \"build:copy-files\": \"node ./scripts/copy-build-files.js\",\n+    \"precommit\": \"lint-staged\",\n+    \"format\": \"prettier --write src/**/*.ts* docs/src/**/*.{js,css}\"\n+  },\n   \"peerDependencies\": {\n+    \"@types/react\": \"*\",\n     \"react\": \">=16.4.0\",\n     \"react-dom\": \">=16.4.0\"\n   },\n+  \"peerDependenciesMeta\": {\n+    \"@types/react\": {\n+      \"optional\": true\n+    }\n+  },\n   \"dependencies\": {\n-    \"@emotion/core\": \"^10.0.27\",\n-    \"@emotion/styled\": \"^10.0.27\",\n-    \"tslib\": \"^1.10.0\"\n-  },\n-  \"main\": \"index.js\",\n-  \"umd:main\": \"umd/react-easy-crop.js\",\n-  \"unpkg\": \"umd/react-easy-crop.js\",\n-  \"jsdelivr\": \"umd/react-easy-crop.js\",\n-  \"module\": \"index.module.js\",\n-  \"jsnext:main\": \"index.module.js\",\n-  \"react-native\": \"index.module.js\",\n-  \"types\": \"./index.d.ts\"\n-}\n\\ No newline at end of file\n+    \"normalize-wheel\": \"^1.0.1\"\n+  },\n+  \"devDependencies\": {\n+    \"@auto-it/all-contributors\": \"11.3.6\",\n+    \"@auto-it/first-time-contributor\": \"11.3.6\",\n+    \"@auto-it/released\": \"11.3.6\",\n+    \"@percy/cli\": \"^1.31.14\",\n+    \"@percy/cypress\": \"^3.1.1\",\n+    \"@types/lodash.debounce\": \"^4.0.6\",\n+    \"@types/node\": \"^25.9.2\",\n+    \"@types/react\": \"^18.0.28\",\n+    \"@types/react-dom\": \"^18.0.10\",\n+    \"@typescript-eslint/eslint-plugin\": \"^5.51.0\",\n+    \"@typescript-eslint/parser\": \"^5.51.0\",\n+    \"all-contributors-cli\": \"^6.4.0\",\n+    \"auto\": \"11.3.6\",\n+    \"cypress\": \"^15.17.0\",\n+    \"eslint\": \"^8.34.0\",\n",
