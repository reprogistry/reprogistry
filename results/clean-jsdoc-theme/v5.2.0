+    \"build:all\": \"turbo run build build:docs\",\n+    \"dev\": \"turbo run dev\",\n+    \"test\": \"turbo run test\",\n+    \"lint\": \"turbo run lint\",\n+    \"format\": \"prettier --write .\",\n+    \"format:check\": \"prettier --check .\",\n+    \"typecheck\": \"turbo run typecheck\",\n+    \"check:docs\": \"node scripts/check-docs.mjs\",\n+    \"gen:llms\": \"node scripts/gen-llms-txt.mjs\",\n+    \"clean\": \"pnpm -r --parallel run clean && node scripts/clean.mjs node_modules\",\n+    \"clean-node-modules\": \"pnpm -r --parallel run clean-node-modules && node scripts/clean.mjs node_modules\",\n+    \"changeset\": \"changeset\",\n+    \"release:check\": \"changeset status --verbose\",\n+    \"version-packages\": \"changeset version && pnpm install --lockfile-only\",\n+    \"release\": \"turbo run build && changeset publish\"\n   },\n+  \"homepage\": \"https://ankdev.me/clean-jsdoc-theme/v4/index.html\",\n   \"keywords\": [\n     \"jsdoc\",\n+    \"template\",\n     \"jsdoc-template\",\n-    \"jsdoc-theme\",\n-    \"documentation\"\n+    \"jsdoc to markdown\",\n+    \"javascript documentation\",\n+    \"customizable jsdoc theme / template\",\n+    \"llm docs\"\n   ],\n-  \"scripts\": {\n-    \"build\": \"tsdown\",\n-    \"dev\": \"tsdown --watch\",\n-    \"lint\": \"eslint src\",\n-    \"test\": \"vitest run\",\n-    \"typecheck\": \"tsc --noEmit\",\n-    \"clean\": \"node ../../scripts/clean.mjs dist .turbo\",\n",
