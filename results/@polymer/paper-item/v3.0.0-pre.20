e=\"\">\n+            <paper-item-body two-line>\n               <div>(650) 555-1234</div>\n-              <div secondary=\"\">Mobile</div>\n+              <div secondary>Mobile</div>\n             </paper-item-body>\n           </paper-icon-item>\n           <paper-icon-item>\n             <div class=\"avatar blue\" slot=\"item-icon\"></div>\n-            <paper-item-body two-line=\"\">\n+            <paper-item-body two-line>\n               <div>Alphonso Engelking</div>\n",
