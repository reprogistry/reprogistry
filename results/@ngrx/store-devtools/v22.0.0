				"package.json": {
					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,62 +1,175 @@\n {\n-  \"name\": \"@ngrx/store-devtools\",\n+  \"name\": \"@ngrx/platform\",\n   \"version\": \"22.0.0\",\n-  \"description\": \"Developer tools for @ngrx/store\",\n-  \"repository\": {\n-    \"type\": \"git\",\n-    \"url\": \"git+https://github.com/ngrx/platform.git\"\n+  \"description\": \"monorepo for ngrx development\",\n+  \"scripts\": {\n+    \"ng\": \"ng\",\n+    \"build\": \"nx run-many --target=build --all\",\n+    \"deploy:builds\": \"npx tsx ./build/deploy-build.ts\",\n+    \"test\": \"nx run-many --target=test --all\",\n+    \"clean\": \"git clean -xdf\",\n+    \"coverage:html\": \"nyc report --reporter=html\",\n+    \"copy:dist\": \"ncp dist/ ./node_modules/@ngrx/\",\n+    \"ci\": \"pnpm exec run test && nyc report --reporter=text-lcov | coveralls\",\n+    \"prettier\": \"prettier --write \\\"**/*.ts\\\"\",\n+    \"postinstall\": \"opencollective postinstall\",\n+    \"changelog\": \"conventional-changelog -p angular -i CHANGELOG.md -s\",\n+    \"copy:schematics\": \"npx tsx ./build/copy-schematics-core.ts\",\n+    \"schematics:check\": \"git diff --name-only --exit-code ./modules\",\n+    \"build:stackblitz\": \"npx tsx ./build/stackblitz.ts && git add ./stackblitz.html\",\n+    \"publish:next\": \"npx tsx ./build/publish-rc.1\",\n+    \"publish:latest\": \"npx tsx ./build/publish-latest.ts\",\n+    \"nx\": \"nx\",\n+    \"update\": \"nx migrate latest\",\n+    \"update:check\": \"ng update\",\n+    \"update:versions\": \"npx tsx ./build/update-version-numbers.ts\",\n+    \"lint\": \"nx run-many --target=lint --all\",\n+    \"eslint-plugin:update\": \"npx tsx ./build/generate-eslint-plugin.ts\",\n+    \"prepare\": \"husky install\"\n+  },\n+  \"engines\": {\n+    \"node\": \"^22.22.3 || ^24.15.0 || >=26.0.0\",\n+    \"pnpm\": \"^11.0.0\"\n+  },\n+  \"packageManager\": \"pnpm@11.18.0\",\n+  \"lint-staged\": {\n+    \"*.{ts,json,md}\": [\n+      \"prettier --write\",\n+      \"git add\"\n+    ]\n   },\n   \"keywords\": [\n-    \"RxJS\",\n-    \"Angular\",\n-    \"Redux\",\n-    \"Store\",\n-    \"@ngrx/store\"\n+    \"ngrx\",\n+    \"angular\",\n+    \"rxjs\"\n   ],\n-  \"author\": \"NgRx\",\n+  \"author\": \"Rob Wormald <robwormald@gmail.com>\",\n   \"license\": \"MIT\",\n-  \"bugs\": {\n-    \"url\": \"https://github.com/ngrx/platform/issues\"\n+  \"repository\": {\n+    \"type\": \"git\",\n+    \"url\": \"https://github.com/ngrx/platform.git\"\n   },\n-  \"homepage\": \"https://github.com/ngrx/platform#readme\",\n-  \"peerDependencies\": {\n-    \"@angular/core\": \"^22.0.0\",\n-    \"@ngrx/store\": \"22.0.0\",\n-    \"rxjs\": \"^6.5.3 || ^7.5.0\"\n-  },\n-  \"schematics\": \"./schematics/collection.json\",\n-  \"ng-update\": {\n-    \"packageGroupName\": \"@ngrx/store\",\n-    \"packageGroup\": [\n-      \"@ngrx/store\",\n-      \"@ngrx/effects\",\n-      \"@ngrx/entity\",\n-      \"@ngrx/router-store\",\n-      \"@ngrx/data\",\n-      \"@ngrx/schematics\",\n-      \"@ngrx/store-devtools\",\n-      \"@ngrx/component-store\",\n-      \"@ngrx/component\",\n-      \"@ngrx/eslint-plugin\",\n-      \"@ngrx/operators\",\n-      \"@ngrx/signals\"\n+  \"nyc\": {\n+    \"extension\": [\n+      \".ts\"\n     ],\n-    \"migrations\": \"./migrations/migration.json\"\n+    \"exclude\": [\n+      \"**/*.spec\",\n+      \"**/spec/**/*\",\n+      \"/modules/schematics/src/*/files/**/*\",\n+      \"/modules/**/schematics/**/files/**/*\",\n+      \"**/schematics/src/utility/*\"\n",
