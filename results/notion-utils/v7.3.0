				"package.json": {
					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,42 +1,54 @@\n {\n-  \"name\": \"notion-utils\",\n-  \"version\": \"7.3.0\",\n-  \"type\": \"module\",\n-  \"description\": \"Useful utilities for working with Notion data. Isomorphic.\",\n+  \"name\": \"notion\",\n+  \"private\": true,\n+  \"description\": \"Fast and accurate React renderer for Notion. TS batteries included.\",\n   \"repository\": \"NotionX/react-notion-x\",\n   \"author\": \"Travis Fischer <travis@transitivebullsh.it>\",\n   \"license\": \"MIT\",\n-  \"main\": \"./build/index.js\",\n-  \"module\": \"./build/index.js\",\n-  \"types\": \"./build/index.d.ts\",\n-  \"exports\": {\n-    \".\": {\n-      \"types\": \"./build/index.d.ts\",\n-      \"default\": \"./build/index.js\"\n-    }\n-  },\n-  \"sideEffects\": false,\n-  \"files\": [\n-    \"build\"\n-  ],\n+  \"version\": \"7.3.0\",\n+  \"packageManager\": \"pnpm@10.6.4\",\n   \"engines\": {\n     \"node\": \">=18\"\n   },\n-  \"dependencies\": {\n-    \"is-url-superb\": \"^6.1.0\",\n-    \"memoize\": \"^10.1.0\",\n-    \"normalize-url\": \"^8.0.1\",\n-    \"p-queue\": \"^8.1.0\",\n-    \"notion-types\": \"7.3.0\"\n-  },\n   \"scripts\": {\n-    \"build\": \"tsup\",\n-    \"dev\": \"tsup --watch\",\n-    \"watch\": \"tsup --watch --silent --onSuccess 'echo build successful'\",\n-    \"clean\": \"del build\",\n-    \"test\": \"run-s test:*\",\n-    \"test:lint\": \"eslint .\",\n-    \"test:typecheck\": \"tsc --noEmit\",\n-    \"test:unit\": \"vitest run\"\n+    \"build\": \"turbo build --filter='./packages/*'\",\n+    \"dev\": \"turbo dev --concurrency 50 --continue\",\n+    \"clean\": \"turbo clean\",\n+    \"test\": \"turbo test\",\n+    \"test:format\": \"prettier --check \\\"**/*.{js,ts,tsx}\\\"\",\n+    \"test:lint\": \"turbo test:lint\",\n+    \"test:typecheck\": \"turbo test:typecheck\",\n+    \"test:unit\": \"turbo test:unit\",\n+    \"release\": \"bumpp -r && pnpm publish -r\",\n+    \"pretest\": \"run-s build\",\n+    \"preinstall\": \"npx only-allow pnpm\",\n+    \"prepare\": \"simple-git-hooks\"\n+  },\n+  \"devDependencies\": {\n+    \"@fisch0920/eslint-config\": \"^1.4.0\",\n+    \"@total-typescript/ts-reset\": \"^0.6.1\",\n+    \"@types/node\": \"^22.13.10\",\n+    \"bumpp\": \"^10.1.0\",\n+    \"del-cli\": \"^6.0.0\",\n+    \"eslint\": \"^8.57.1\",\n+    \"npm-run-all2\": \"^7.0.2\",\n+    \"prettier\": \"^3.5.3\",\n+    \"react\": \"^19.0.0\",\n+    \"react-dom\": \"^19.0.0\",\n+    \"simple-git-hooks\": \"^2.11.1\",\n+    \"tsup\": \"^8.4.0\",\n+    \"tsx\": \"^4.19.3\",\n+    \"turbo\": \"^2.4.4\",\n+    \"typescript\": \"^5.8.2\",\n+    \"vitest\": \"^3.0.9\"\n+  },\n+  \"simple-git-hooks\": {\n+    \"pre-commit\": \"npx lint-staged\"\n+  },\n+  \"lint-staged\": {\n+    \"*.{ts,tsx}\": [\n+      \"prettier --ignore-unknown --write\",\n+      \"eslint --fix\"\n+    ]\n   }\n-}\n\\ No newline at end of file\n+}\n",
