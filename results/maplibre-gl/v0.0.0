				"package.json": {
					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,10 +1,177 @@\n {\n   \"name\": \"maplibre-gl\",\n-  \"description\": \"A WebGL interactive maps library\",\n-  \"version\": \"0.0.0\",\n-  \"license\": \"BSD-3\",\n+  \"description\": \"BSD licensed community fork of mapbox-gl, a WebGL interactive maps library\",\n+  \"version\": \"6.19.0\",\n+  \"module\": \"dist/maplibre-gl.mjs\",\n+  \"style\": \"dist/maplibre-gl.css\",\n+  \"license\": \"BSD-3-Clause\",\n+  \"homepage\": \"https://maplibre.org/\",\n+  \"funding\": \"https://github.com/maplibre/maplibre-gl-js?sponsor=1\",\n+  \"bugs\": {\n+    \"url\": \"https://github.com/maplibre/maplibre-gl-js/issues/\"\n+  },\n   \"repository\": {\n     \"type\": \"git\",\n-    \"url\": \"git://github.com/MapLibre/maplibre-gl-js.git\"\n+    \"url\": \"https://github.com/maplibre/maplibre-gl-js\"\n+  },\n+  \"types\": \"dist/maplibre-gl.d.ts\",\n+  \"type\": \"module\",\n+  \"exports\": {\n+    \".\": {\n+      \"types\": \"./dist/maplibre-gl.d.ts\",\n+      \"import\": \"./dist/maplibre-gl.mjs\"\n+    },\n+    \"./dist/*\": \"./dist/*\",\n+    \"./package.json\": \"./package.json\"\n+  },\n+  \"sideEffects\": [\n+    \"*.css\",\n+    \"src/**/*.ts\"\n+  ],\n+  \"dependencies\": {\n+    \"@mapbox/point-geometry\": \"^1.1.0\",\n+    \"@mapbox/tiny-sdf\": \"^2.3.0\",\n+    \"@mapbox/unitbezier\": \"^1.0.0\",\n+    \"@mapbox/vector-tile\": \"^3.0.0\",\n+    \"@maplibre/geojson-vt\": \"^7.0.1\",\n+    \"@maplibre/maplibre-gl-style-spec\": \"^26.8.0\",\n+    \"@maplibre/mlt\": \"^1.3.0\",\n+    \"@maplibre/vt-pbf\": \"^4.3.3\",\n+    \"@types/geojson\": \"^7946.0.16\",\n+    \"bidi-js\": \"^1.1.0\",\n+    \"earcut\": \"^3.2.4\",\n+    \"gl-matrix\": \"^3.4.4\",\n+    \"kdbush\": \"^4.1.0\",\n+    \"murmurhash-js\": \"^1.0.0\",\n+    \"pbf\": \"^5.1.2\",\n+    \"potpack\": \"^2.1.0\",\n+    \"quickselect\": \"^3.0.0\",\n+    \"tinyqueue\": \"^3.0.0\",\n+    \"zustand\": \"^5.1.0\"\n+  },\n+  \"devDependencies\": {\n+    \"@fontsource/noto-sans-devanagari\": \"^5.3.0\",\n+    \"@fontsource/noto-sans-hebrew\": \"^5.3.0\",\n+    \"@fontsource/noto-sans-khmer\": \"^5.3.0\",\n+    \"@fontsource/noto-sans-myanmar\": \"^5.3.0\",\n+    \"@fontsource/noto-sans-thai\": \"^5.3.0\",\n+    \"@mapbox/mvt-fixtures\": \"^4.0.0\",\n+    \"@stylistic/eslint-plugin\": \"^6.0.1\",\n+    \"@types/d3\": \"^7.4.3\",\n+    \"@types/earcut\": \"^3.2.4\",\n+    \"@types/eslint\": \"^9.6.1\",\n+    \"@types/gl\": \"^6.0.5\",\n+    \"@types/jsdom\": \"^30.0.0\",\n+    \"@types/minimist\": \"^1.2.5\",\n+    \"@types/murmurhash-js\": \"^1.0.7\",\n+    \"@types/nise\": \"^1.4.5\",\n+    \"@types/node\": \"^26.6.6\",\n+    \"@types/offscreencanvas\": \"^2019.7.3\",\n+    \"@types/pngjs\": \"^6.0.5\",\n+    \"@types/request\": \"^2.48.13\",\n+    \"@types/shuffle-seed\": \"^1.1.3\",\n+    \"@types/window-or-global\": \"^1.0.6\",\n+    \"@typescript-eslint/eslint-plugin\": \"^8.73.0\",\n+    \"@typescript-eslint/parser\": \"^8.59.3\",\n+    \"@typescript/native-preview\": \"beta\",\n+    \"@unicode/unicode-17.0.0\": \"^2.1.0\",\n+    \"@vitest/coverage-v8\": \"5.1.0\",\n+    \"@vitest/eslint-plugin\": \"^1.6.28\",\n+    \"@vitest/ui\": \"5.1.0\",\n+    \"address\": \"^2.0.3\",\n+    \"autoprefixer\": \"^10.6.2\",\n+    \"canvas\": \"^3.2.3\",\n+    \"cross-env\": \"^10.1.0\",\n+    \"cspell\": \"^10.5.1\",\n+    \"cssnano\": \"^9.9.0\",\n+    \"d3\": \"^7.9.2\",\n+    \"d3-queue\": \"^3.0.7\",\n+    \"devtools-protocol\": \"^0.0.1746437\",\n+    \"diff\": \"^9.0.0\",\n+    \"eslint\": \"^10.15.0\",\n+    \"eslint-plugin-html\": \"^8.2.1\",\n+    \"eslint-plugin-import-x\": \"^4.18.1\",\n",
