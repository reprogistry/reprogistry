					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,47 +1,55 @@\n {\n   \"name\": \"waterline\",\n-  \"version\": \"0.6.0\",\n-  \"description\": \"Active Record for Node.js\",\n-  \"main\": \"waterline.js\",\n-  \"directories\": {\n-    \"test\": \"test\"\n-  },\n-  \"scripts\": {\n-    \"test\": \"node ./node_modules/mocha/bin/mocha --globals ___transaction --recursive  --globals User -b -R landing -t 8000\"\n+  \"description\": \"An ORM for Node.js and the Sails framework\",\n+  \"version\": \"0.15.2\",\n+  \"homepage\": \"http://waterlinejs.org\",\n+  \"contributors\": [\n+    {\n+      \"name\": \"seerepo\",\n+      \"github\": \"https://github.com/balderdashy/waterline/graphs/contributors\"\n+    }\n+  ],\n+  \"dependencies\": {\n+    \"@sailshq/lodash\": \"^3.10.2\",\n+    \"anchor\": \"^1.2.0\",\n+    \"async\": \"2.6.4\",\n+    \"encrypted-attr\": \"1.0.6\",\n+    \"flaverr\": \"^1.9.2\",\n+    \"lodash.issafeinteger\": \"4.0.4\",\n+    \"parley\": \"^3.3.2\",\n+    \"rttc\": \"^10.0.0-1\",\n+    \"waterline-schema\": \"^1.0.0-20\",\n+    \"waterline-utils\": \"^1.3.7\"\n   },\n-  \"repository\": {\n-    \"type\": \"git\",\n-    \"url\": \"git://github.com/balderdashy/waterline.git\"\n+  \"devDependencies\": {\n+    \"eslint\": \"4.11.0\",\n+    \"mocha\": \"3.0.2\"\n   },\n   \"keywords\": [\n-    \"active-record\",\n-    \"activerecord\",\n+    \"mvc\",\n     \"orm\",\n-    \"model\",\n     \"mysql\",\n-    \"mongo\",\n+    \"postgresql\",\n+    \"redis\",\n     \"mongodb\",\n-    \"postgres\",\n-    \"adapter\",\n+    \"active-record\",\n+    \"waterline\",\n     \"sails\",\n-    \"rails\"\n+    \"sails.js\"\n   ],\n-  \"author\": \"Mike McNeil\",\n-  \"license\": \"MIT\",\n-  \"dependencies\": {\n-    \"underscore\": \"=1.4.3\",\n-    \"underscore.string\": \"2.3.1\",\n-    \"async\": \"0.1.22\",\n-    \"node-uuid\": \"1.4.0\",\n-    \"fs-extra\": \"0.3.2\",\n-    \"require-all\": \"0.0.5\",\n-    \"parley\": \"0.0.2\",\n-    \"sails-util\": \"0.1.0\",\n-    \"sails-moduleloader\": \"1.1.5\"\n+  \"repository\": \"git://github.com/balderdashy/waterline.git\",\n+  \"main\": \"./lib/waterline\",\n+  \"scripts\": {\n+    \"test\": \"nodever=`node -e \\\"console.log('\\\\`node -v\\\\`'[1]);\\\"` && if [ $nodever != \\\"0\\\" ]; then npm run lint; fi && npm run custom-tests\",\n+    \"custom-tests\": \"node ./node_modules/mocha/bin/mocha test --recursive\",\n+    \"lint\": \"node ./node_modules/eslint/bin/eslint . --max-warnings=0 --ignore-pattern 'test/'\",\n+    \"browserify\": \"rm -rf .dist && mkdir .dist && browserify lib/waterline.js -s Waterline | uglifyjs > .dist/waterline.min.js\"\n   },\n-  \"devDependencies\": {\n-    \"waterline-dirty\": \"~0.4.4\",\n-    \"mocha\": \"~1.8.1\",\n-    \"waterline-mysql\": \"~0.5.0\"\n-  }\n+  \"engines\": {\n+    \"node\": \">=4\"\n+  },\n+  \"bugs\": {\n+    \"url\": \"https://sailsjs.com/bugs\"\n+  },\n+  \"license\": \"MIT\"\n }\n",
