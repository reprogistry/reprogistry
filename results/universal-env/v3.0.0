",\n-    \"babel-eslint\": \"^10.0.1\",\n-    \"driver-dom\": \"^1.0.0\",\n-    \"eslint\": \"^5.15.1\",\n-    \"eslint-config-rax\": \"^0.0.0\",\n-    \"eslint-plugin-import\": \"^2.17.2\",\n-    \"eslint-plugin-react\": \"^7.12.4\",\n-    \"rax\": \"^1.0.4\",\n-    \"rax-plugin-api-builder\": \"^0.0.1\",\n-    \"rax-plugin-component\": \"^0.1.5\",\n-    \"rax-scripts\": \"^2.0.0\",\n-    \"rax-text\": \"^1.0.1\",\n-    \"rax-view\": \"^1.0.2\"\n-  },\n-  \"repository\": {\n-    \"type\": \"git\",\n-    \"url\": \"https://github.com/raxjs/universal-api.git\"\n+  \"lint-staged\": {\n+    \"src/packages/**/src/**/*.{ts,tsx}\": [\n+      \"eslint --fix\",\n+      \"git add\"\n+    ]\n   },\n-  \"bugs\": {\n-    \"url\": \"https://github.com/raxjs/universal-api/issues\"\n+  \"dependencies\": {\n+    \"@babel/runtime-corejs3\": \"^7.12.5\"\n   },\n-  \"homepage\": \"https://github.com/raxjs/universal-api#readme\"\n+  \"devDependencies\": {\n+    \"@babel/core\": \"^7.6.4\",\n+    \"@babel/plugin-proposal-class-properties\": \"^7.7.4\",\n+    \"@babel/plugin-syntax-dynamic-import\": \"^7.7.4\",\n+    \"@babel/plugin-transform-runtime\": \"^7.7.6\",\n+    \"@babel/preset-env\": \"^7.6.3\",\n+    \"@commitlint/cli\": \"^12.0.0\",\n+    \"@iceworks/spec\": \"^1.1.0\",\n+    \"@rollup/plugin-alias\": \"^3.1.1\",\n+    \"@rollup/plugin-babel\": \"^5.2.1\",\n+    \"@rollup/plugin-commonjs\": \"^16.0.0\",\n+    \"@rollup/plugin-json\": \"^4.1.0\",\n+    \"@rollup/plugin-node-resolve\": \"^10.0.0\",\n+    \"@types/jest\": \"^27.0.2\",\n+    \"@types/jsdom\": \"^16.2.12\",\n+    \"axios\": \">=0.21.1\",\n+    \"babel-eslint\": \"^10.0.1\",\n+    \"babel-loader\": \"^8.2.2\",\n+    \"babel-plugin-module-resolver\": \"^4.1.0\",\n+    \"build-scripts\": \"^0.1.25\",\n+    \"case-sensitive-paths-webpack-plugin\": \"^2.3.0\",\n+    \"chalk\": \"^4.1.0\",\n",
