					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,58 +1,127 @@\n {\n-    \"name\": \"react-native-video\",\n-    \"version\": \"5.1.0-alpha6\",\n-    \"description\": \"A <Video /> element for react-native\",\n-    \"main\": \"Video.js\",\n-    \"license\": \"MIT\",\n-    \"author\": \"Brent Vatne <brentvatne@gmail.com> (https://github.com/brentvatne)\",\n-    \"contributors\": [\n-        {\n-            \"name\": \"Isaiah Grey\",\n-            \"email\": \"isaiahgrey@gmail.com\"\n-        },\n-        {\n-            \"name\": \"Johannes Lumpe\",\n-            \"email\": \"johannes@lum.pe\"\n-        },\n-        {\n-            \"name\": \"Baris Sencan\",\n-            \"email\": \"baris.sncn@gmail.com\"\n-        },\n-        {\n-            \"name\": \"Hampton Maxwell\",\n-            \"email\": \"me@hamptonmaxwell.com\"\n-        }\n-    ],\n-    \"repository\": {\n-        \"type\": \"git\",\n-        \"url\": \"git@github.com:react-native-community/react-native-video.git\"\n+  \"name\": \"react-native-video-monorepo\",\n+  \"packageManager\": \"bun@1.3.1\",\n+  \"version\": \"7.0.0-beta.13\",\n+  \"private\": true,\n+  \"repository\": \"https://github.com/TheWidlarzGroup/react-native-video\",\n+  \"author\": \"TheWidlarzGroup <hi@thewidlarzgroup.com> (https://github.com/TheWidlarzGroup)\",\n+  \"workspaces\": [\n+    \"packages/react-native-video\",\n+    \"packages/drm-plugin\",\n+    \"example\",\n+    \"test-app\",\n+    \"docs\"\n+  ],\n+  \"scripts\": {\n+    \"build\": \"bun --filter=\\\"./packages/**\\\" run build\",\n+    \"specs\": \"bun --filter=\\\"./packages/**\\\" specs\",\n+    \"lint\": \"bun --filter=\\\"**\\\" lint\",\n+    \"typecheck\": \"bun --filter=\\\"**\\\" typecheck\",\n+    \"test\": \"bun test e2e scripts test-app packages/react-native-video/__tests__\",\n+    \"clean\": \"git clean -xdf\",\n+    \"react-native-video\": \"bun run --cwd packages/react-native-video\",\n+    \"drm-plugin\": \"bun run --cwd packages/drm-plugin\",\n+    \"example\": \"bun run --cwd example\",\n+    \"test-app\": \"bun run --cwd test-app\",\n+    \"docs\": \"bun run --cwd docs\",\n+    \"postinstall\": \"patch-package --patch-dir example/patches && patch-package --patch-dir test-app/patches\",\n+    \"release:github\": \"release-it --preRelease beta\",\n+    \"release\": \"./scripts/release.sh\"\n+  },\n+  \"devDependencies\": {\n+    \"@commitlint/config-conventional\": \"^17.0.2\",\n+    \"@eslint/js\": \"^9.10.0\",\n+    \"@evilmartians/lefthook\": \"^1.5.0\",\n+    \"@octokit/rest\": \"22.0.1\",\n+    \"@react-native/eslint-config\": \"^0.77.0\",\n+    \"@release-it/bumper\": \"^7.0.6\",\n+    \"@release-it/conventional-changelog\": \"^11.0.1\",\n+    \"@tsconfig/react-native\": \"^2.0.2\",\n+    \"@types/eslint__js\": \"^8.42.3\",\n+    \"@types/node\": \"^24.9.1\",\n+    \"@types/react\": \"^18.2.44\",\n+    \"commitlint\": \"^17.0.2\",\n+    \"conventional-changelog-conventionalcommits\": \"^9.3.1\",\n+    \"eslint\": \"^8.51.0\",\n+    \"eslint-plugin-prettier\": \"^5.0.1\",\n+    \"patch-package\": \"^8.0.0\",\n+    \"prettier\": \"^3.0.3\",\n+    \"react\": \"18.3.1\",\n+    \"react-native\": \"^0.77.0\",\n+    \"release-it\": \"^20.2.0\",\n+    \"typescript\": \"^5.2.2\",\n+    \"typescript-eslint\": \"^8.13.0\"\n+  },\n+  \"commitlint\": {\n+    \"extends\": [\n+      \"@commitlint/config-conventional\"\n+    ]\n+  },\n+  \"release-it\": {\n+    \"npm\": {\n+      \"publish\": false\n     },\n-    \"devDependencies\": {\n-        \"@react-native-community/eslint-config\": \"0.0.7\",\n-        \"babel-eslint\": \"10.0.3\",\n-        \"eslint\": \"6.8.0\",\n-        \"react\": \"^16.12.0\",\n-        \"react-dom\": \"^16.12.0\",\n-        \"react-hot-loader\": \"^4.12.19\",\n",
