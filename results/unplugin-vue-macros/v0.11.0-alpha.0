					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,95 +1,43 @@\n {\n-  \"name\": \"unplugin-vue-macros\",\n+  \"name\": \"monorepo-unplugin-vue-macros\",\n   \"version\": \"0.11.0-alpha.0\",\n+  \"private\": true,\n   \"packageManager\": \"pnpm@7.9.3\",\n-  \"description\": \"\",\n-  \"keywords\": [\n-    \"unplugin\",\n-    \"vue\",\n-    \"macros\",\n-    \"script-setup\",\n-    \"define-options\",\n-    \"define-model\",\n-    \"define-render\",\n-    \"setup-sfc\",\n-    \"setup-component\"\n-  ],\n-  \"license\": \"MIT\",\n-  \"homepage\": \"https://github.com/sxzz/unplugin-vue-macros#readme\",\n-  \"bugs\": {\n-    \"url\": \"https://github.com/sxzz/unplugin-vue-macros/issues\"\n-  },\n-  \"repository\": {\n-    \"type\": \"git\",\n-    \"url\": \"git+https://github.com/sxzz/unplugin-vue-macros.git\"\n-  },\n+  \"description\": \"Monorepo for Vue macros.\",\n   \"author\": \"三咲智子 <sxzz@sxzz.moe>\",\n-  \"files\": [\n-    \"dist\",\n-    \"macros-global.d.ts\"\n-  ],\n-  \"main\": \"dist/index.js\",\n-  \"module\": \"dist/index.mjs\",\n-  \"types\": \"index.d.ts\",\n-  \"exports\": {\n-    \".\": {\n-      \"require\": \"./dist/index.js\",\n-      \"import\": \"./dist/index.mjs\"\n-    },\n-    \"./vite\": {\n-      \"require\": \"./dist/vite.js\",\n-      \"import\": \"./dist/vite.mjs\"\n-    },\n-    \"./webpack\": {\n-      \"require\": \"./dist/webpack.js\",\n-      \"import\": \"./dist/webpack.mjs\"\n-    },\n-    \"./rollup\": {\n-      \"require\": \"./dist/rollup.js\",\n-      \"import\": \"./dist/rollup.mjs\"\n-    },\n-    \"./esbuild\": {\n-      \"require\": \"./dist/esbuild.js\",\n-      \"import\": \"./dist/esbuild.mjs\"\n-    },\n-    \"./macros-global\": \"./macros-global.d.ts\",\n-    \"./*\": \"./*\"\n-  },\n-  \"typesVersions\": {\n-    \"*\": {\n-      \"*\": [\n-        \"./dist/*\",\n-        \"./*\"\n-      ]\n-    }\n+  \"scripts\": {\n+    \"build\": \"pnpm run --filter \\\"./packages/*\\\" --stream build\",\n+    \"dev\": \"pnpm run --filter \\\"./packages/*\\\" --parallel dev\",\n+    \"play\": \"pnpm run -C ./playground dev\",\n+    \"test\": \"vitest\",\n+    \"release\": \"bumpp package.json ./packages/*/package.json && pnpm run build && pnpm publish -r\",\n+    \"lint\": \"eslint . --ext .vue,.ts,.md,.json --max-warnings 0\",\n+    \"typecheck\": \"run-p typecheck:lib typecheck:test\",\n+    \"typecheck:lib\": \"tsc --noEmit -p tsconfig.lib.json\",\n+    \"typecheck:test\": \"tsc --noEmit -p tsconfig.test.json\"\n   },\n   \"peerDependencies\": {\n     \"vue\": \"^2.7.0 || ^3.2.25\"\n   },\n-  \"dependencies\": {\n-    \"@rollup/pluginutils\": \"^4.2.1\",\n-    \"@vue-macros/common\": \"0.11.0-alpha.0\",\n-    \"@vue-macros/define-model\": \"^0.11.0-alpha.0\",\n-    \"@vue-macros/define-render\": \"^0.11.0-alpha.0\",\n-    \"@vue-macros/hoist-static\": \"^0.11.0-alpha.0\",\n-    \"@vue-macros/setup-component\": \"^0.11.0-alpha.0\",\n-    \"@vue-macros/setup-sfc\": \"^0.11.0-alpha.0\",\n-    \"local-pkg\": \"^0.4.2\",\n-    \"unplugin-combine\": \"^0.2.1-beta.0\",\n-    \"unplugin-vue-define-options\": \"0.11.0-alpha.0\"\n-  },\n   \"devDependencies\": {\n+    \"@pnpm/find-workspace-packages\": \"^4.0.31\",\n+    \"@pnpm/logger\": \"^4.0.0\",\n+    \"@sxzz/eslint-config\": \"^2.4.1\",\n",
