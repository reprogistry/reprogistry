			"files": {
				"CHANGELOG.md": {
					"diff": "--- published/CHANGELOG.md\n+++ rebuilt/CHANGELOG.md\n@@ -5,7 +5,7 @@\n \n ## 1.13.10 (2022-05-20)\n \n-**Note:** Version bump only for package @saberhq/solana-contrib\n+**Note:** Version bump only for package @saberhq/saber-common\n \n \n \n@@ -24,7 +24,7 @@\n \n ## 1.13.8 (2022-05-20)\n \n-**Note:** Version bump only for package @saberhq/solana-contrib\n+**Note:** Version bump only for package @saberhq/saber-common\n \n \n \n@@ -43,7 +43,7 @@\n \n ## 1.13.6 (2022-05-13)\n \n-**Note:** Version bump only for package @saberhq/solana-contrib\n+**Note:** Version bump only for package @saberhq/saber-common\n \n \n \n@@ -51,7 +51,7 @@\n \n ## 1.13.5 (2022-05-13)\n \n-**Note:** Version bump only for package @saberhq/solana-contrib\n+**Note:** Version bump only for package @saberhq/saber-common\n \n \n \n@@ -59,7 +59,7 @@\n \n ## 1.13.4 (2022-05-13)\n \n-**Note:** Version bump only for package @saberhq/solana-contrib\n+**Note:** Version bump only for package @saberhq/saber-common\n \n \n \n@@ -67,7 +67,7 @@\n \n ## 1.13.3 (2022-05-13)\n \n-**Note:** Version bump only for package @saberhq/solana-contrib\n+**Note:** Version bump only for package @saberhq/saber-common\n \n \n \n@@ -86,7 +86,7 @@\n \n ## 1.13.1 (2022-05-05)\n \n-**Note:** Version bump only for package @saberhq/solana-contrib\n+**Note:** Version bump only for package @saberhq/saber-common\n \n \n \n@@ -94,7 +94,7 @@\n \n # 1.13.0 (2022-05-02)\n \n-**Note:** Version bump only for package @saberhq/solana-contrib\n+**Note:** Version bump only for package @saberhq/saber-common\n \n \n \n@@ -113,7 +113,7 @@\n \n ## 1.12.71 (2022-04-29)\n \n-**Note:** Version bump only for package @saberhq/solana-contrib\n+**Note:** Version bump only for package @saberhq/saber-common\n \n \n \n@@ -121,7 +121,7 @@\n \n ## 1.12.70 (2022-04-29)\n \n-**Note:** Version bump only for package @saberhq/solana-contrib\n+**Note:** Version bump only for package @saberhq/saber-common\n \n \n \n@@ -129,7 +129,7 @@\n \n ## 1.12.69 (2