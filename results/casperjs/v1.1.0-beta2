 tests', 19, function(test) {\n     var fpath = fs.pathJoin(phantom.casperPath, 'README.md');\n \n     casper.start('tests/site/form.html', function() {\n         this.fill('form[action=\"result.html\"]', {\n             email:         'chuck@norris.com',\n-            password:      'chuck',\n+            password:      42,\n             content:       'Am watching thou',\n",
