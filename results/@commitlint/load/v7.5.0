n+  },\n+  \"commitlint\": {\n+    \"extends\": [\n+      \"./@commitlint/config-conventional\",\n+      \"./@commitlint/config-lerna-scopes\"\n     ]\n   },\n-  \"babel\": {\n-    \"presets\": [\n-      \"babel-preset-commitlint\"\n+  \"prettier\": {\n+    \"useTabs\": true,\n+    \"singleQuote\": true,\n+    \"bracketSpacing\": false\n+  },\n+  \"lint-staged\": {\n+    \"*.js\": [\n+      \"prettier --write\",\n+      \"git add\"\n     ]\n   },\n+  \"renovate\": {\n+    \"dependencies\": {\n+      \"semanticPrefix\": \"chore:\",\n+      \"semanticCommitScope\": \"\"\n+    },\n+    \"extends\": [\n+      \"config:base\"\n+    ],\n+    \"pin\": {\n+      \"semanticPrefix\": \"chore:\",\n+      \"semanticCommitScope\": \"\"\n+    },\n+    \"semanticPrefix\": \"chore:\",\n+    \"semanticCommitScope\": \"\"\n+  },\n+  \"workspaces\": [\n+    \"@alias/*\",\n+    \"@commitlint/*\",\n+    \"@packages/*\"\n+  ],\n   \"engines\": {\n-    \"node\": \">=4\"\n+    \"node\": \">=6\"\n   },\n   \"repository\": {\n     \"type\": \"git\",\n@@ -46,35 +67,41 @@\n   },\n   \"homepage\": \"https://github.com/conventional-changelog/commitlint#readme\",\n   \"keywords\": [\n",
