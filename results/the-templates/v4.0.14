					"diff": "--- published/asset/templates/cjs_dir.hbs\n+++ rebuilt/asset/templates/cjs_dir.hbs\n@@ -8,17 +8,17 @@\n const _d = (m) => (m && 'default' in m) ? m.default : m\n \n {{#each modules}}\n-const {{varName}} = require('./{{path}}')\n+const {{varName}} = _d(require('./{{path}}'))\n {{/each}}\n {{#if defaultModule}}\n-const {{defaultModule.varName}} = require('./{{defaultModule.path}}')\n+const {{defaultModule.varName}} = _d(require('./{{defaultModule.path}}'))\n {{/if}}\n \n {{#if defaultModule}}{{#if modules}}// `module.exports` overrides these `exports.*`, but still needs them for lebab (https://github.com/lebab/lebab){{/if}}{{/if}}\n {{#each modules}}\n-exports.{{name}} = _d({{varName}})\n+exports.{{name}} = {{varName}}\n {{/each}}\n {{#if defaultModule}}\n \n-module.exports = _d({{defaultModule.varName}})\n+module.exports = {{defaultModule.varName}}\n {{/if}}\n\\ No newline at end of file\n",
