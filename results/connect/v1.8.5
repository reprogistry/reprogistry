.use = function use(route, fn) {\n+  var handle = fn;\n+  var path = route;\n+\n+  // default route to '/'\n+  if (typeof route !== 'string') {\n+    handle = route;\n+    path = '/';\n+  }\n+\n+  // wrap sub-apps\n+  if (typeof handle.handle === 'function') {\n+    var server = handle;\n+    server.route = path;\n+    handle = function (req, res, next) {\n+      server.handle(req, res, next);\n+    };\n+  }\n+\n+  // wrap vanilla http.Servers\n",
