				"package.json": {
					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,157 +1,130 @@\n {\n   \"name\": \"p5\",\n   \"repository\": \"processing/p5.js\",\n+  \"type\": \"module\",\n   \"scripts\": {\n-    \"grunt\": \"grunt\",\n-    \"build\": \"grunt build\",\n-    \"dev\": \"grunt browserify:dev connect:yui watch:quick\",\n-    \"docs\": \"grunt yui\",\n-    \"docs:dev\": \"grunt yui:dev\",\n-    \"test\": \"grunt\",\n-    \"lint\": \"grunt lint-no-fix\",\n-    \"lint:source\": \"grunt lint-no-fix:source\",\n-    \"lint:samples\": \"grunt lint-no-fix:samples\",\n-    \"lint:fix\": \"grunt lint-fix\",\n-    \"contributors:add\": \"all-contributors add\",\n-    \"contributors:generate\": \"all-contributors generate\",\n-    \"generate\": \"all-contributors generate\",\n-    \"release\": \"grunt release-p5\",\n-    \"prepublishOnly\": \"grunt prerelease\"\n+    \"build\": \"rolldown -c\",\n+    \"dev\": \"vite preview/\",\n+    \"dev:global\": \"concurrently -n build,server \\\"rolldown -c -w\\\" \\\"npx vite preview/global/\\\"\",\n+    \"docs\": \"documentation build ./src/**/*.js ./src/**/**/*.js --shallow -o ./docs/data.json && node ./utils/convert.mjs\",\n+    \"bench\": \"vitest bench\",\n+    \"bench:report\": \"vitest bench --reporter=verbose\",\n+    \"test\": \"vitest\",\n+    \"test:types\": \"tsc test/types/*.ts --noEmit --lib es2022,dom\",\n+    \"lint\": \"oxlint .\",\n+    \"lint:fix\": \"oxlint --fix .\",\n+    \"generate-types\": \"npm run docs && node utils/typescript.mjs\",\n+    \"prepack\": \"npm run generate-types\"\n   },\n   \"lint-staged\": {\n-    \"ignore\": [\n-      \"test/js/**/*.js\"\n-    ],\n-    \"Gruntfile.js\": \"eslint\",\n-    \"docs/preprocessor.js\": \"eslint\",\n-    \"utils/**/*.js\": \"eslint\",\n-    \"tasks/**/*.js\": \"eslint\",\n-    \"test/**/*.js\": \"eslint\",\n-    \"src/**/*.js\": [\n-      \"eslint\",\n-      \"node --require @babel/register ./utils/sample-linter.js\"\n-    ]\n+    \"src/**/*.js\": \"oxlint\",\n+    \"test/**/*.js\": \"oxlint\",\n+    \"utils/**/*.{js,mjs}\": \"oxlint\"\n+  },\n+  \"version\": \"2.4.0\",\n+  \"dependencies\": {\n+    \"@davepagurek/bezier-path\": \"^0.0.7\",\n+    \"@japont/unicode-range\": \"^1.0.0\",\n+    \"acorn\": \"^8.15.0\",\n+    \"acorn-walk\": \"^8.3.4\",\n+    \"colorjs.io\": \"^0.6.0\",\n+    \"escodegen\": \"^2.1.0\",\n+    \"gifenc\": \"^1.0.3\",\n+    \"libtess\": \"^1.2.2\",\n+    \"omggif\": \"^1.0.10\",\n+    \"pako\": \"^2.1.0\",\n+    \"tl-util\": \"npm:@limzykenneth/tl-util@0.0.1\",\n+    \"zimmerframe\": \"^1.1.4\",\n+    \"zod\": \"^4.2.1\"\n   },\n-  \"version\": \"1.3.0\",\n   \"devDependencies\": {\n-    \"@babel/core\": \"^7.7.7\",\n-    \"@babel/preset-env\": \"^7.7.7\",\n-    \"@babel/register\": \"^7.7.7\",\n-    \"all-contributors-cli\": \"^6.19.0\",\n-    \"babel-plugin-i18next-extract\": \"^0.5.0\",\n-    \"babel-plugin-istanbul\": \"^5.2.0\",\n-    \"babel-plugin-static-fs\": \"^1.2.1\",\n-    \"babelify\": \"^10.0.0\",\n-    \"browserify\": \"^16.5.0\",\n-    \"chai\": \"^3.5.0\",\n-    \"connect-modrewrite\": \"^0.10.1\",\n-    \"derequire\": \"^2.0.0\",\n-    \"es6-promise\": \"^4.2.8\",\n-    \"eslint\": \"^5.14.1\",\n-    \"eslint-config-prettier\": \"2.7.0\",\n-    \"eslint-plugin-prettier\": \"2.3.1\",\n-    \"fetch-jsonp\": \"^1.1.3\",\n-    \"file-saver\": \"^1.3.8\",\n-    \"grunt\": \"^1.0.4\",\n-    \"grunt-cli\": \"^1.3.2\",\n-    \"grunt-contrib-clean\": \"^1.1.0\",\n-    \"grunt-contrib-compress\": \"^1.6.0\",\n-    \"grunt-contrib-connect\": \"^2.1.0\",\n-    \"grunt-contrib-copy\": \"^1.0.0\",\n-    \"grunt-contrib-uglify\": \"^4.0.1\",\n-    \"grunt-contrib-watch\": \"^1.1.0\",\n-    \"grunt-contrib-yuidoc\": \"1.0.0\",\n-    \"grunt-eslint\": \"^20.2.0\",\n-    \"grunt-minjson\": \"^0.4.0\",\n",
