				"package.json": {
					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,53 +1,68 @@\n {\n   \"name\": \"grunt-uncss\",\n   \"description\": \"A grunt task for generating CSS files containing only those styles used in your project.\",\n-  \"version\": \"0.1.0\",\n-  \"homepage\": \"https://github.com/addyosmani/grunt-uncss\",\n-  \"author\": {\n-    \"name\": \"Addy Osmani\",\n-    \"email\": \"addyosmani@gmail.com\"\n-  },\n+  \"version\": \"0.10.1\",\n+  \"homepage\": \"https://github.com/uncss/grunt-uncss\",\n+  \"author\": \"Addy Osmani <addyosmani@gmail.com> (https://addyosmani.com/)\",\n+  \"maintainers\": [\n+    \"Addy Osmani <addyosmani@gmail.com> (https://addyosmani.com/)\",\n+    \"XhmikosR <xhmikosr@gmail.com> (https://github.com/XhmikosR)\"\n+  ],\n   \"repository\": {\n     \"type\": \"git\",\n-    \"url\": \"git://github.com/addyosmani/grunt-uncss.git\"\n+    \"url\": \"git+https://github.com/uncss/grunt-uncss.git\"\n   },\n   \"bugs\": {\n-    \"url\": \"https://github.com/addyosmani/grunt-uncss/issues\"\n+    \"url\": \"https://github.com/uncss/grunt-uncss/issues\"\n   },\n-  \"licenses\": [\n-    {\n-      \"type\": \"MIT\",\n-      \"url\": \"https://github.com/addyosmani/grunt-uncss/blob/master/LICENSE-MIT\"\n-    }\n+  \"license\": \"MIT\",\n+  \"keywords\": [\n+    \"gruntplugin\",\n+    \"uncss\",\n+    \"css\"\n+  ],\n+  \"files\": [\n+    \"tasks/*.js\"\n   ],\n-  \"main\": \"Gruntfile.js\",\n   \"engines\": {\n-    \"node\": \">= 0.8.0\"\n+    \"node\": \">=14.18.0\"\n   },\n   \"scripts\": {\n-    \"test\": \"grunt test\"\n+    \"mocha\": \"mocha \\\"tests/*.js\\\"\",\n+    \"xo\": \"xo\",\n+    \"fix\": \"xo --fix\",\n+    \"test\": \"npm run xo && grunt test && npm run mocha\"\n   },\n-  \"peerDependencies\": {\n-    \"grunt\": \"~0.4.1\"\n+  \"dependencies\": {\n+    \"chalk\": \"^4.1.2\",\n+    \"maxmin\": \"^3.0.0\",\n+    \"uncss\": \"^0.17.3\"\n   },\n   \"devDependencies\": {\n-    \"grunt-contrib-jshint\": \"~0.3.0\",\n-    \"grunt-contrib-clean\": \"~0.4.0\",\n-    \"grunt-contrib-nodeunit\": \"~0.1.2\",\n-    \"grunt\": \"~0.4.1\",\n-    \"grunt-contrib-watch\": \"~0.3.1\",\n-    \"grunt-contrib-connect\": \"~0.3.0\",\n-    \"grunt-processhtml\": \"~0.1.1\",\n-    \"grunt-contrib-copy\": \"~0.4.1\",\n-    \"grunt-compare-size\": \"~0.4.0-rc.3\"\n+    \"chai\": \"^4.3.6\",\n+    \"grunt\": \"^1.5.3\",\n+    \"mocha\": \"^10.2.0\",\n+    \"time-grunt\": \"^2.0.0\",\n+    \"xo\": \"^0.53.1\"\n   },\n-  \"keywords\": [\n-    \"gruntplugin\",\n-    \"uncss\",\n-    \"css\"\n-  ],\n-  \"dependencies\": {\n-    \"underscore\": \"~1.4.4\",\n-    \"uncss\": \"~0.4.1-0\"\n+  \"peerDependencies\": {\n+    \"grunt\": \">=0.4.0\"\n+  },\n+  \"xo\": {\n+    \"space\": 4,\n+    \"ignores\": [\n+      \"tests/app/**\"\n+    ],\n+    \"rules\": {\n+      \"capitalized-comments\": \"off\",\n+      \"comma-dangle\": \"off\",\n+      \"object-curly-spacing\": [\n+        \"error\",\n+        \"always\"\n+      ],\n",
					"match": false,
					"packageHash": "01fb9cd86ac3f3bc5717090623131fde052d7233a9125dd70c2b002b4425b3da",
					"size": 1271,
					"sourceHash": "138d0bb1be90ad95b8e7b9ae8b00b211c9539d79351a6622cb726fb1e04e1a96",
					"status": "content"
