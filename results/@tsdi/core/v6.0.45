				"package.json": {
					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,34 +1,97 @@\n {\n-  \"name\": \"@tsdi/core\",\n-  \"version\": \"6.0.45\",\n-  \"description\": \"@tsdi/core is Ioc container, via typescript decorator\",\n+  \"name\": \"tsioc-srcs\",\n+  \"version\": \"6.0.48\",\n+  \"description\": \"AOP,  Ioc container, Boot framework, unit testing framework , activities workflow framework.\",\n   \"scripts\": {\n-    \"build\": \"ts-node -r tsconfig-paths/register taskfile.ts\"\n+    \"postinstall\": \"npm prune\",\n+    \"reinstall\": \"npm cache clean && npm install\",\n+    \"build\": \"ts-node -r tsconfig-paths/register builder.ts\"\n   },\n-  \"keywords\": [\"core\", \"ioc\", \"IoC\", \"Injector\", \"container\", \"dependency\", \"injection\", \"AOP\", \"aop\", \"tsdi\", \"@tsdi\", \"tsioc\", \"type\"],\n-  \"author\": \"houjun\",\n+  \"keywords\": [\n+    \"IoC\",\n+    \"AOP\",\n+    \"dependency\",\n+    \"injection\",\n+    \"framework\",\n+    \"unit\",\n+    \"test\",\n+    \"container\",\n+    \"decorator\",\n+    \"autofac\",\n+    \"Inject\",\n+    \"type\",\n+    \"typescript\"\n+  ],\n+  \"author\": \"houjun <freebirds8281@hotmail.com>\",\n   \"license\": \"MIT\",\n   \"bugs\": {\n     \"url\": \"https://github.com/zhouhoujun/tsioc/issues\"\n   },\n   \"repository\": {\n     \"type\": \"git\",\n-    \"url\": \"https://github.com/zhouhoujun/tsioc.git\"\n+    \"url\": \"git+https://github.com/zhouhoujun/tsioc.git\"\n   },\n-  \"homepage\": \"https://github.com/zhouhoujun/tsioc#readme\",\n-  \"dependencies\": {},\n-  \"peerDependencies\": {\n-    \"tslib\": \"^2.3.0\",\n-    \"@tsdi/ioc\": \"~6.0.45\"\n+  \"devDependencies\": {\n+    \"@types/execa\": \"^2.0.0\",\n+    \"@types/mocha\": \"^7.0.2\",\n+    \"@types/shelljs\": \"^0.8.0\",\n+    \"@types/vinyl-fs\": \"^2.4.8\",\n+    \"assert\": \"^2.0.0\",\n+    \"bluebird\": \"^3.7.2\",\n+    \"chalk\": \"^4.0.0\",\n+    \"chokidar\": \"^3.4.0\",\n+    \"commander\": \"^4.1.1\",\n+    \"core-js\": \"^3.6.4\",\n+    \"del\": \"^5.1.0\",\n+    \"execa\": \"^4.0.2\",\n+    \"expect\": \"^25.3.0\",\n+    \"findup\": \"^0.1.5\",\n+    \"globby\": \"^11.1.0\",\n+    \"gulp-filter\": \"^6.0.0\",\n+    \"gulp-json-editor\": \"^2.5.2\",\n+    \"gulp-rename\": \"^1.4.0\",\n+    \"gulp-replace\": \"^0.5.4\",\n+    \"gulp-rollup\": \"^2.16.2\",\n+    \"gulp-sourcemaps\": \"~2.6.4\",\n+    \"gulp-typescript\": \"~5.0.1\",\n+    \"gulp-uglify-es\": \"~2.0.0\",\n+    \"interpret\": \"^2.0.0\",\n+    \"json-in-place\": \"^1.0.1\",\n+    \"liftoff\": \"^2.5.0\",\n+    \"lodash\": \"^4.13.1\",\n+    \"log4js\": \"^6.7.1\",\n+    \"minimatch\": \"^3.0.4\",\n+    \"minimist\": \"^1.2.5\",\n+    \"on-change\": \"^1.6.2\",\n+    \"path\": \"^0.12.7\",\n+    \"pg\": \"^8.0.2\",\n+    \"pretty-hrtime\": \"^1.0.3\",\n+    \"readable-stream\": \"~2.0.1\",\n+    \"reflect-metadata\": \"^0.1.13\",\n+    \"rollup\": \"^1.31.1\",\n+    \"rollup-plugin-commonjs\": \"^10.1.0\",\n+    \"rollup-plugin-hypothetical\": \"^2.1.0\",\n+    \"rollup-plugin-inject\": \"^3.0.1\",\n+    \"rollup-plugin-node-builtins\": \"^2.1.2\",\n+    \"rollup-plugin-node-globals\": \"^1.4.0\",\n+    \"rollup-plugin-node-resolve\": \"^5.2.0\",\n+    \"rollup-plugin-sourcemaps\": \"^0.4.2\",\n+    \"rollup-plugin-uglify\": \"^6.0.3\",\n+    \"rollup-pluginutils\": \"^2.8.2\",\n+    \"rxjs\": \"^6.3.3\",\n+    \"shelljs\": \"^0.8.3\",\n+    \"source-map\": \"~0.7.3\",\n+    \"through2\": \"^3.0.0\",\n+    \"time-stamp\": \"^2.2.0\",\n",
