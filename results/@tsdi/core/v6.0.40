					"diff": "--- published/package.json\n+++ rebuilt/package.json\n@@ -1,36 +1,96 @@\n {\n-  \"name\": \"@tsdi/core\",\n+  \"name\": \"tsioc-srcs\",\n   \"version\": \"6.0.40\",\n-  \"description\": \"@tsdi/core is Ioc container, via typescript decorator\",\n+  \"description\": \"AOP,  Ioc container, Boot framework, unit testing framework , activities workflow framework.\",\n   \"scripts\": {\n+    \"postinstall\": \"npm prune\",\n+    \"reinstall\": \"npm cache clean && npm install\",\n     \"build\": \"ts-node -r tsconfig-paths/register taskfile.ts\"\n   },\n-  \"keywords\": [\"core\", \"ioc\", \"IoC\", \"Injector\", \"container\", \"dependency\", \"injection\", \"AOP\", \"aop\", \"tsdi\", \"@tsdi\", \"tsioc\", \"type\"],\n-  \"author\": \"houjun\",\n+  \"keywords\": [\n+    \"IoC\",\n+    \"AOP\",\n+    \"dependency\",\n+    \"injection\",\n+    \"framework\",\n+    \"unit\",\n+    \"test\",\n+    \"container\",\n+    \"decorator\",\n+    \"autofac\",\n+    \"Inject\",\n+    \"type\",\n+    \"typescript\"\n+  ],\n+  \"author\": \"houjun <freebirds8281@hotmail.com>\",\n   \"license\": \"MIT\",\n   \"bugs\": {\n     \"url\": \"https://github.com/zhouhoujun/tsioc/issues\"\n   },\n   \"repository\": {\n     \"type\": \"git\",\n-    \"url\": \"https://github.com/zhouhoujun/tsioc.git\"\n+    \"url\": \"git+https://github.com/zhouhoujun/tsioc.git\"\n   },\n-  \"homepage\": \"https://github.com/zhouhoujun/tsioc#readme\",\n   \"dependencies\": {},\n-  \"peerDependencies\": {\n+  \"devDependencies\": {\n+    \"@types/execa\": \"^2.0.0\",\n+    \"@types/mocha\": \"^7.0.2\",\n+    \"@types/shelljs\": \"^0.8.0\",\n+    \"@types/vinyl-fs\": \"^2.4.8\",\n+    \"assert\": \"^2.0.0\",\n+    \"bluebird\": \"^3.7.2\",\n+    \"chalk\": \"^4.0.0\",\n+    \"chokidar\": \"^3.4.0\",\n+    \"commander\": \"^4.1.1\",\n+    \"core-js\": \"^3.6.4\",\n+    \"del\": \"^5.1.0\",\n+    \"execa\": \"^4.0.2\",\n+    \"expect\": \"^25.3.0\",\n+    \"findup\": \"^0.1.5\",\n+    \"globby\": \"^11.0