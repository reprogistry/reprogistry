": \">=0.6.2\"\n+  },\n+  \"main\": \"dist/socketcan.js\",\n+  \"types\": \"dist/socketcan.d.ts\",\n+  \"files\": [\n+    \"binding.gyp\",\n+    \"dist\",\n+    \"samples\",\n+    \"src\",\n+    \"native\",\n+    \"docs\"\n+  ],\n+  \"engines\": {\n+    \"node\": \">=22.0.0\"\n   },\n-  \"dependencies\": { \"xml2js\": \">=0.2.0\" },\n-  \"main\": \"can.js\"\n+  \"os\": [\n+    \"linux\"\n+  ],\n+  \"overrides\": {\n+    \"diff\": \"^9.0.0\",\n+    \"serialize-javascript\": \"^7.0.5\",\n+    \"uuid\": \"^14.0.0\"\n+  }\n }\n",
